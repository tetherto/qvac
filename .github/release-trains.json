{
  "sdk": {
    "groups": ["engine", "agentstack"],
    "anchorGroup": "engine",
    "githubRelease": {
      "project": "@qvac/sdk",
      "name": "QVAC SDK"
    },
    "checks": ["shared-runtime-libs", "sdk-python", "package-checks"],
    "packageChecks": ".github/sdk-pod-checks.json"
  },
  "sdk-tools": {
    "groups": ["agentstack"],
    "anchorProject": "@qvac/sdk-tools",
    "fromNpm": ["packages/sdk"],
    "checks": ["package-checks"],
    "packageChecks": ".github/sdk-pod-checks.json"
  }
}

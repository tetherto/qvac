#!/usr/bin/env bash
# Stands in for `npm` while testing the mobile setup action's prebuild download
# step. Records how npm was invoked and what registry configuration it would
# have resolved, so the test can assert routing without touching a network.
set -uo pipefail

LOG="${MOCK_NPM_LOG:?MOCK_NPM_LOG must be set}"

case "${1:-}" in
  pack|config) ;;
  *)
    echo "mock-npm: only 'pack' and 'config get' are supported, got '${1:-}'" >&2
    exit 64
    ;;
esac

COMMAND="${1:-}"
SPEC="${2:-}"

# `npm pack <spec> [--ignore-scripts] [--pack-destination <dir>]`. The action
# packs the meta package and its per-platform package into separate dirs so the
# `*.tgz` globs it extracts with stay unambiguous, so the mock has to honour
# --pack-destination rather than always dropping the tarball in cwd. Flags are
# scanned rather than read at fixed positions, so adding or reordering one does
# not silently break the destination handling. Positional parameters are NOT
# shifted: the `config get` branch below still reads them.
PACK_DESTINATION="$PWD"
IGNORE_SCRIPTS="no"
if [ "$COMMAND" = "pack" ]; then
  pack_args_seen=0
  expect_destination="no"
  for arg in "$@"; do
    pack_args_seen=$((pack_args_seen + 1))
    # Skip `pack` and the spec itself.
    [ "$pack_args_seen" -le 2 ] && continue
    if [ "$expect_destination" = "yes" ]; then
      PACK_DESTINATION="$arg"
      expect_destination="no"
      continue
    fi
    case "$arg" in
      --pack-destination) expect_destination="yes" ;;
      --ignore-scripts)   IGNORE_SCRIPTS="yes" ;;
      *)
        echo "mock-npm: unsupported pack flag '$arg'" >&2
        exit 64
        ;;
    esac
  done
  if [ "$expect_destination" = "yes" ]; then
    echo "mock-npm: --pack-destination needs a directory" >&2
    exit 64
  fi
fi

# Reproduce npm's ACTUAL project-config rule, not a cwd approximation: npm reads
# the project .npmrc from its localPrefix — the nearest ANCESTOR directory (cwd
# first, then upward) containing package.json or node_modules. Modelling this
# faithfully is the point: an .npmrc sitting in cwd is IGNORED when some
# directory above owns localPrefix, which is how a @tetherto spec can silently
# fall back to registry.npmjs.org. A cwd-only mock cannot catch that regression.
find_local_prefix () {
  local dir="$PWD"
  while :; do
    if [ -e "$dir/package.json" ] || [ -d "$dir/node_modules" ]; then
      printf '%s' "$dir"
      return 0
    fi
    [ "$dir" = "/" ] && break
    dir="$(dirname "$dir")"
  done
  # No owner found: npm falls back to treating cwd as the prefix.
  printf '%s' "$PWD"
}

LOCAL_PREFIX="$(find_local_prefix)"
NPMRC="$LOCAL_PREFIX/.npmrc"

# MOCK_NPM_IGNORE_NPMRC simulates the localPrefix trap: the .npmrc exists on disk
# but npm never reads it (some ancestor owns localPrefix), which is exactly the
# silent misroute the action's registry-in-effect check exists to catch.
if [ -n "${MOCK_NPM_IGNORE_NPMRC:-}" ]; then
  NPMRC="/nonexistent/.npmrc"
fi

REGISTRY="https://registry.npmjs.org"
AUTH="none"
SCOPE="${SPEC%%/*}"
if [ -f "$NPMRC" ]; then
  MAPPED=$(sed -n "s|^${SCOPE}:registry=||p" "$NPMRC")
  if [ -n "$MAPPED" ]; then
    REGISTRY="$MAPPED"
    HOST_PATH="${MAPPED#https://}"
    if grep -q "^//${HOST_PATH}/:_authToken=." "$NPMRC"; then
      AUTH="token"
    fi
  fi
fi

# `npm config get <scope>:registry` — the action asks this to prove the .npmrc is
# in effect. Resolved through the same localPrefix rule as everything else, so a
# shadowed .npmrc correctly reports the npmjs default here.
if [ "${1:-}" = "config" ]; then
  if [ "${2:-}" != "get" ]; then
    echo "mock-npm: only 'config get' is supported" >&2
    exit 64
  fi
  KEY="${3:-}"
  KEY_SCOPE="${KEY%:registry}"
  VALUE="https://registry.npmjs.org"
  if [ -f "$NPMRC" ]; then
    FOUND=$(sed -n "s|^${KEY_SCOPE}:registry=||p" "$NPMRC")
    [ -n "$FOUND" ] && VALUE="$FOUND"
  fi
  echo "config_get key=$KEY value=$VALUE local_prefix=$LOCAL_PREFIX" >> "$LOG"
  printf '%s\n' "$VALUE"
  exit 0
fi

# Permissions have to be sampled here: the step deletes the .npmrc on exit, so
# the test cannot inspect it afterwards. GNU and BSD stat disagree on flags.
npmrc_mode () {
  [ -f "$NPMRC" ] || { printf 'absent'; return; }
  stat -c '%a' "$NPMRC" 2>/dev/null || stat -f '%OLp' "$NPMRC" 2>/dev/null || printf 'unknown'
}

{
  echo "spec=$SPEC"
  echo "cwd=$PWD"
  echo "local_prefix=$LOCAL_PREFIX"
  echo "registry=$REGISTRY"
  echo "auth=$AUTH"
  echo "npmrc_present=$([ -f "$NPMRC" ] && echo yes || echo no)"
  echo "npmrc_mode=$(npmrc_mode)"
  echo "ignore_scripts=$IGNORE_SCRIPTS"
} >> "$LOG"

echo "mock-npm: pack $SPEC via $REGISTRY (auth=$AUTH)"

# MOCK_NPM_FAIL_WITH simulates the registry rejecting the spec.
if [ -n "${MOCK_NPM_FAIL_WITH:-}" ]; then
  echo "npm error code E${MOCK_NPM_FAIL_WITH}" >&2
  echo "npm error ${MOCK_NPM_FAIL_WITH} - GET ${REGISTRY}/${SPEC%@*} - Not found" >&2
  exit 1
fi

# Success: emit a tarball shaped like a real addon package. MOCK_NPM_VERSION
# drives package.json so the provenance assertion can be exercised, and
# MOCK_NPM_NO_PREBUILDS omits prebuilds/ to exercise that guard.
#
# Two layouts are modelled, because QVAC-24574 gave split addons a second one:
#
#   meta (unsplit, and every @tetherto -mono dev build)
#     package/package.json
#     package/prebuilds/<host>/addon.bare
#
#   meta (split: JS only, slices pinned in optionalDependencies)
#     package/package.json   -> optionalDependencies: { "<name>-<suffix>": ver }
#
#   slice (per-platform package)
#     package/package.json
#     package/addon/prebuilds/<host>/addon.bare      <- one level DEEPER
#
# Slice suffixes and their host dirs mirror SLICE_DEFINITIONS in
# scripts/ci/slice-platform-packages.mjs; note that all three iOS host dirs
# ship in the single 'ios' slice.
SLICE_SUFFIXES="linux-x64 linux-arm64 darwin-arm64 darwin-x64 win32-x64 android-arm64 ios"

# Derive the name the way npm does, not with a blind strip at the last '@':
# a scoped spec starts with '@', so "${SPEC%@*}" is EMPTY for a versionless
# "@scope/name". Fabricating a name there would make any name-provenance
# assertion vacuous. MOCK_NPM_NAME overrides it so a test can simulate the
# registry returning a DIFFERENT package than the one requested.
case "${SPEC#@*/}" in
  *@*) NAME="${SPEC%@*}" ;;
  *)   NAME="$SPEC" ;;
esac
VERSION="${MOCK_NPM_VERSION:-${SPEC##*@}}"

# Is this a per-platform package? Decided from the requested name, before any
# MOCK_NPM_*_NAME override, so a test can make the registry return the wrong
# name without also changing which layout it returns.
SLICE_SUFFIX=""
for suffix in $SLICE_SUFFIXES; do
  case "$NAME" in
    *"-$suffix") SLICE_SUFFIX="$suffix" ;;
  esac
done

if [ -n "$SLICE_SUFFIX" ]; then
  # MOCK_NPM_SLICE_FAIL rejects only the slice resolve, leaving the meta
  # resolve to succeed — the "meta published without its slices" case.
  if [ -n "${MOCK_NPM_SLICE_FAIL:-}" ]; then
    echo "npm error code E404" >&2
    echo "npm error 404 - GET ${REGISTRY}/${NAME} - Not found" >&2
    exit 1
  fi
  NAME="${MOCK_NPM_SLICE_NAME:-$NAME}"
  # A slice resolve honours the version it was ASKED for. MOCK_NPM_VERSION
  # belongs to the meta resolve (it models a dist-tag landing on a concrete
  # version); letting it leak here would make the slice appear to resolve
  # elsewhere on every split test. MOCK_NPM_SLICE_VERSION is the explicit
  # "registry returned a different version" override.
  VERSION="${MOCK_NPM_SLICE_VERSION:-${SPEC##*@}}"
else
  NAME="${MOCK_NPM_NAME:-$NAME}"
fi

STAGE="$(mktemp -d)"
mkdir -p "$STAGE/package"

if [ -n "$SLICE_SUFFIX" ]; then
  printf '{"name":"%s","version":"%s"}\n' "$NAME" "$VERSION" > "$STAGE/package/package.json"
  # MOCK_NPM_SLICE_NO_PREBUILDS models a corrupted publish: the slice exists and
  # passes provenance but carries no binaries.
  if [ -z "${MOCK_NPM_SLICE_NO_PREBUILDS:-}" ]; then
    case "$SLICE_SUFFIX" in
      ios)   SLICE_HOSTS="ios-arm64 ios-arm64-simulator ios-x64-simulator" ;;
      *)     SLICE_HOSTS="$SLICE_SUFFIX" ;;
    esac
    for host in $SLICE_HOSTS; do
      mkdir -p "$STAGE/package/addon/prebuilds/$host"
      echo mock > "$STAGE/package/addon/prebuilds/$host/addon.bare"
    done
  fi
elif [ -n "${MOCK_NPM_SPLIT:-}" ]; then
  # Split meta: no prebuilds/, every slice pinned at an exact version.
  # MOCK_NPM_SLICE_PIN pins the slices at a DIFFERENT version than the meta, so
  # a test can prove the action reads the pin rather than reusing the meta's.
  SLICE_PIN="${MOCK_NPM_SLICE_PIN:-$VERSION}"
  OPTIONAL=""
  for suffix in $SLICE_SUFFIXES; do
    [ -n "$OPTIONAL" ] && OPTIONAL="$OPTIONAL,"
    OPTIONAL="$OPTIONAL\"$NAME-$suffix\":\"$SLICE_PIN\""
  done
  printf '{"name":"%s","version":"%s","optionalDependencies":{%s}}\n' \
    "$NAME" "$VERSION" "$OPTIONAL" > "$STAGE/package/package.json"
else
  printf '{"name":"%s","version":"%s"}\n' "$NAME" "$VERSION" > "$STAGE/package/package.json"
  if [ -z "${MOCK_NPM_NO_PREBUILDS:-}" ]; then
    mkdir -p "$STAGE/package/prebuilds/android-arm64" "$STAGE/package/prebuilds/ios-arm64"
    echo mock > "$STAGE/package/prebuilds/android-arm64/addon.bare"
    echo mock > "$STAGE/package/prebuilds/ios-arm64/addon.bare"
  fi
fi

mkdir -p "$PACK_DESTINATION"
TARBALL="$PACK_DESTINATION/mock-package.tgz"
tar -czf "$TARBALL" -C "$STAGE" package
rm -rf "$STAGE"
echo "$TARBALL"

#!/usr/bin/env bash
set -euo pipefail

EXPECTED_HEAD_SHA="${MOCK_EXPECTED_HEAD_SHA:-}"
EXPECTED_RUNS_URL="repos/${GITHUB_REPOSITORY}/actions/workflows/on-pr-fabric.yml/runs?head_sha=${EXPECTED_HEAD_SHA}&per_page=20"
EXPECTED_RUN_URL="repos/${GITHUB_REPOSITORY}/actions/runs/4242"
EXPECTED_ARTIFACTS_URL="repos/${GITHUB_REPOSITORY}/actions/runs/4242/artifacts"

# Provenance fields of the mocked run. Defaults describe a run the consumer must
# accept; tests override them to describe one it must reject.
RUN_HEAD_SHA="${MOCK_RUN_HEAD_SHA:-$EXPECTED_HEAD_SHA}"
RUN_PATH="${MOCK_RUN_PATH:-.github/workflows/on-pr-fabric.yml}"
RUN_EVENT="${MOCK_RUN_EVENT:-pull_request_target}"
RUN_HEAD_REPO="${MOCK_RUN_HEAD_REPO:-$GITHUB_REPOSITORY}"
RUN_PULL_REQUESTS="${MOCK_RUN_PULL_REQUESTS:-[]}"
RUN_STATUS="${MOCK_RUN_STATUS:-completed}"
RUN_CONCLUSION="${MOCK_RUN_CONCLUSION:-success}"

# The run listing is served as real JSON through the caller's own --jq, so a
# selector that filters the producing run out is observable here rather than
# only in production. Everything else answers with the value gh would print.
extract_jq_expr() {
  local i j
  for ((i = 1; i <= $#; i++)); do
    if [ "${!i}" = "--jq" ]; then
      j=$((i + 1))
      printf '%s' "${!j:-}"
      return 0
    fi
  done
  printf ''
}

if [ "${1:-}" = "api" ]; then
  # detect-fabric-stack resolves the merge base here. The mock answers with a
  # SHA the test controls, so drift between the base tip and the branch point
  # can be driven rather than waited for.
  case "${2:-}" in
    repos/*/compare/*)
      if [ -n "${MOCK_COMPARE_MERGE_BASE:-}" ]; then
        printf '%s\n' "$MOCK_COMPARE_MERGE_BASE"
        exit 0
      fi
      ;;
  esac

  if [ "$2" = "$EXPECTED_RUNS_URL" ]; then
    if [ "$RUN_CONCLUSION" = "null" ] || [ -z "$RUN_CONCLUSION" ]; then
      conclusion_json='null'
    else
      conclusion_json="\"$RUN_CONCLUSION\""
    fi
    runs_json=$(printf '{"workflow_runs":[{"id":4242,"status":"%s","conclusion":%s}]}' \
      "$RUN_STATUS" "$conclusion_json")
    jq_expr=$(extract_jq_expr "$@")
    if [ -n "$jq_expr" ]; then
      printf '%s' "$runs_json" | jq -r "$jq_expr"
    else
      printf '%s\n' "$runs_json"
    fi
  elif [ "$2" = "$EXPECTED_RUN_URL" ]; then
    printf '{"id":4242,"head_sha":"%s","path":"%s","event":"%s","head_repository":{"full_name":"%s"},"pull_requests":%s}\n' \
      "$RUN_HEAD_SHA" "$RUN_PATH" "$RUN_EVENT" "$RUN_HEAD_REPO" "$RUN_PULL_REQUESTS"
  elif [ "$2" = "$EXPECTED_ARTIFACTS_URL" ]; then
    printf '%s\n' "$MOCK_EXPECTED_ARTIFACT"
  else
    printf 'Unexpected gh api URL: %s\n' "$2" >&2
    exit 1
  fi
  exit 0
fi

if [ "${1:-}" = "run" ] && [ "${2:-}" = "download" ]; then
  shift 2
  download_dir=
  artifact=
  repo=
  run_id=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir)
        download_dir="$2"
        shift 2
        ;;
      --name)
        artifact="$2"
        shift 2
        ;;
      --repo)
        repo="$2"
        shift 2
        ;;
      *)
        run_id="$1"
        shift
        ;;
    esac
  done

  if [ -z "$download_dir" ]; then
    printf '%s\n' 'Missing --dir in gh run download' >&2
    exit 1
  fi
  if [ "$run_id" != "4242" ] || [ "$artifact" != "$MOCK_EXPECTED_ARTIFACT" ] || [ "$repo" != "$GITHUB_REPOSITORY" ]; then
    printf 'Unexpected gh run download selection: run=%s artifact=%s repo=%s\n' "$run_id" "$artifact" "$repo" >&2
    exit 1
  fi

  mkdir -p "$download_dir"
  touch "$download_dir/mock-download-complete"
  exit 0
fi

printf 'Unexpected gh invocation: %s\n' "$*" >&2
exit 1

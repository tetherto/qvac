#!/usr/bin/env bash
set -euo pipefail

if [ "$1" = "fetch" ] && [ "$2" = "origin" ] && [ "$3" = "$MOCK_EXPECTED_HEAD_SHA" ]; then
  touch "$MOCK_GIT_ORIGIN_FAILURE_MARKER"
  exit 1
fi

if [ "$1" = "fetch" ] && [ "$2" = "https://github.com/${MOCK_EXPECTED_HEAD_REPO}.git" ] && [ "$3" = "$MOCK_EXPECTED_HEAD_SHA" ]; then
  touch "$MOCK_GIT_FALLBACK_MARKER"
fi

if [ "$1" = "diff" ] && [ -n "${MOCK_GIT_DIFF_FILES:-}" ]; then
  printf '%s\n' "$MOCK_GIT_DIFF_FILES"
  exit 0
fi

exec /usr/bin/git "$@"

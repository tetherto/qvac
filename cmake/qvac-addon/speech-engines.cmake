include_guard(GLOBAL)
include(FetchContent)

function(qvac_addon_speech_engines)
  if(NOT TARGET qvac-fabric::headers)
    message(FATAL_ERROR "Load @qvac/fabric before building speech engines")
  endif()
  if(TARGET ggml)
    message(FATAL_ERROR "Speech engines require the npm Fabric headers, without another ggml target")
  endif()
  add_library(ggml ALIAS qvac-fabric::headers)
  file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/speech-source.json" source_manifest)
  string(JSON repository GET "${source_manifest}" repository)
  string(JSON revision GET "${source_manifest}" revision)
  string(JSON checksum GET "${source_manifest}" sha512)
  find_package(Git REQUIRED)
  FetchContent_Declare(qvac_speech
    URL "https://github.com/${repository}/archive/${revision}.tar.gz"
    URL_HASH "SHA512=${checksum}"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    SOURCE_SUBDIR qvac-npm-engine-only
    PATCH_COMMAND "${GIT_EXECUTABLE}" apply "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/speech-local-logging.patch"
  )
  FetchContent_MakeAvailable(qvac_speech)
  set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
  set(CMAKE_CXX_VISIBILITY_PRESET hidden)
  set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
  set(CMAKE_DISABLE_FIND_PACKAGE_OpenMP ON)
  if(NOT APPLE)
    set(CMAKE_DISABLE_FIND_PACKAGE_BLAS ON)
  endif()
  if(APPLE)
    enable_language(OBJC OBJCXX)
  endif()
  foreach(engine IN LISTS ARGN)
    qvac_addon_speech_engine("${engine}" "${qvac_speech_SOURCE_DIR}" "${qvac_speech_BINARY_DIR}")
  endforeach()
endfunction()

function(qvac_addon_speech_engine engine source_dir binary_dir)
  if(engine STREQUAL "whisper")
    set(WHISPER_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(WHISPER_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(WHISPER_BUILD_SERVER OFF CACHE BOOL "" FORCE)
    set(WHISPER_BUILD_PARAKEET OFF CACHE BOOL "" FORCE)
    set(WHISPER_BUILD_IS_DEV OFF CACHE BOOL "" FORCE)
    set(WHISPER_USE_SYSTEM_GGML ON CACHE BOOL "" FORCE)
    set(WHISPER_COREML ${APPLE} CACHE BOOL "" FORCE)
    set(WHISPER_COREML_ALLOW_FALLBACK ON CACHE BOOL "" FORCE)
    add_subdirectory("${source_dir}/third_party/whisper.cpp" "${binary_dir}/whisper" EXCLUDE_FROM_ALL)
    add_library(whisper::whisper ALIAS whisper)
  elseif(engine MATCHES "^(parakeet|tts|audiogen)$")
    string(TOUPPER "${engine}" prefix)
    if(engine STREQUAL "tts")
      set(prefix TTS_CPP)
    endif()
    set(${prefix}_BUILD_LIBRARY ON)
    set(${prefix}_BUILD_SHARED OFF)
    set(${prefix}_BUILD_TESTS OFF)
    set(${prefix}_BUILD_EXECUTABLES OFF)
    set(${prefix}_BUILD_EXAMPLES OFF)
    set(${prefix}_INSTALL OFF)
    set(${prefix}_OPENMP OFF)
    set(${prefix}_CCACHE OFF)
    set(${prefix}_USE_SYSTEM_GGML ON)
    set(${prefix}_COREML ${APPLE})
    set(AUDIOGEN_MINIMAX_COREML OFF)
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
      set(AUDIOGEN_MINIMAX_COREML ON)
    endif()
    add_subdirectory("${source_dir}/engines/${engine}" "${binary_dir}/${engine}" EXCLUDE_FROM_ALL)
  else()
    message(FATAL_ERROR "Unknown speech engine: ${engine}")
  endif()
endfunction()

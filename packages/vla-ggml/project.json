{
  "name": "@qvac/vla-ggml",
  "root": "packages/vla-ggml",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/vla-ggml",
        "ci": {
          "hasCppLint": true,
          "includeRocmSdk": true,
          "hasTsChecks": true,
          "tsChecksMode": "dts+lint",
          "hasFabricLockstep": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/vla-ggml",
        "ci": {
          "artifactNamePrefix": "vla-",
          "linuxExtraPackages": "libxi-dev libxtst-dev libxrandr-dev",
          "includeVulkanSdk": true,
          "includeRocm": true
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/vla-ggml"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/vla-ggml",
        "ci": {
          "testCommandSuffix": true,
          "useTeeLogging": true,
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64" },
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64-gpu" },
            { "os": "ubuntu-22.04-arm", "platform": "linux", "arch": "arm64", "runner": "ubuntu-22.04-arm" },
            { "os": "ubuntu-24.04-arm", "platform": "linux", "arch": "arm64", "runner": "ubuntu-24.04-arm" },
            { "os": "macos-15-xlarge", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu" },
            { "os": "macos-15-large", "platform": "darwin", "arch": "x64", "runner": "macos-15-large" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64-gpu" }
          ]
        }
      }
    },
    "test:integration-mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:mobile:validate || true",
        "cwd": "packages/vla-ggml",
        "ci": {
          "npmName": "@qvac/vla-ggml",
          "prebuildArtifactPrefix": "vla-",
          "deviceFarmProjectArnPrimary": "AWS_DEVICE_FARM_PROJECT_ARN_LLAMACPP_EMBED",
          "androidDevicePoolArnPrimary": "ANDROID_DEVICE_POOL_ARN_LLAMACPP_EMBED",
          "iosDevicePoolArnPrimary": "IOS_DEVICE_POOL_ARN_LLAMACPP_EMBED",
          "enablesPerf": true
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/vla-ggml"
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:cpp",
        "cwd": "packages/vla-ggml",
        "ci": {
          "mode": "standard",
          "vulkan": { "os": "ubuntu-24.04", "shell": "bash", "path": "/opt/vulkansdk/x86_64" },
          "platforms": [
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64" },
            { "os": "macos-14", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu" },
            { "os": "macos-15-intel", "platform": "darwin", "arch": "x64" },
            { "os": "windows-2025", "platform": "windows", "arch": "x64", "runner": "qvac-win25-x64" }
          ]
        }
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

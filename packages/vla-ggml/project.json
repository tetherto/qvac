{
  "name": "@qvac/vla-ggml",
  "root": "packages/vla-ggml",
  "tags": ["ci:contract"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/vla-ggml"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:dts",
        "cwd": "packages/vla-ggml"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/vla-ggml"
      }
    },
    "verify:generated": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run check:generated",
        "cwd": "packages/vla-ggml"
      }
    },
    "ci:setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ci/configure-registries.mjs",
        "cwd": "packages/vla-ggml"
      }
    },
    "ci:system": {
      "executor": "nx:run-commands",
      "dependsOn": ["^ci:system"],
      "options": {
        "cwd": "packages/vla-ggml",
        "parallel": false,
        "forwardAllArgs": false,
        "commands": ["echo no system packages"]
      },
      "configurations": {
        "linux-x64": {
          "commands": [
            "dpkg -s libxi-dev libxtst-dev libxrandr-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libxi-dev libxtst-dev libxrandr-dev)"
          ]
        },
        "linux-x64-gpu": {
          "commands": [
            "dpkg -s libxi-dev libxtst-dev libxrandr-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libxi-dev libxtst-dev libxrandr-dev)"
          ]
        },
        "linux-arm64": {
          "commands": [
            "dpkg -s libxi-dev libxtst-dev libxrandr-dev mesa-vulkan-drivers >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libxi-dev libxtst-dev libxrandr-dev mesa-vulkan-drivers)"
          ]
        },
        "linux-arm64-2404": {
          "commands": [
            "dpkg -s libxi-dev libxtst-dev libxrandr-dev mesa-vulkan-drivers >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libxi-dev libxtst-dev libxrandr-dev mesa-vulkan-drivers)"
          ]
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["@qvac/fabric"],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/vla-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm run build:ts",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make generate -D BUILD_TESTING=OFF",
            "forwardAllArgs": true
          },
          {
            "command": "pnpm exec bare-make build",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make install",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "args": "--platform=linux --arch=x64",
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-arm64": {
          "args": "--platform=linux --arch=arm64",
          "ci": {
            "runner": "ubuntu_2204_arm"
          }
        },
        "android-arm64": {
          "args": "--platform=android --arch=arm64 -D ANDROID_STL=c++_shared",
          "ci": {
            "runner": "ubuntu_2404"
          }
        },
        "ios-arm64": {
          "args": "--platform=ios --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-arm64-simulator": {
          "args": "--platform=ios --arch=arm64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-x64-simulator": {
          "args": "--platform=ios --arch=x64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-arm64": {
          "args": "--platform=darwin --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "args": "--platform=darwin --arch=x64",
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "args": "--platform=win32 --arch=x64",
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "inputs": ["default", "!{projectRoot}/prebuilds/**"],
      "outputs": ["{projectRoot}/prebuilds"]
    },
    "cpp:lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["@qvac/fabric"],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/vla-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm exec bare-make generate -D ENABLE_VULKAN=OFF",
            "forwardAllArgs": false
          },
          {
            "command": "node ../../scripts/ci/cpp-lint-changed.mjs --base {args.diff-base}",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120
      }
    },
    "cpp:build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["@qvac/fabric"],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/vla-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm exec bare-make generate -D BUILD_TESTING=ON",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make build --target addon-test",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "darwin-x64": {
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      }
    },
    "cpp:tests": {
      "executor": "nx:run-commands",
      "dependsOn": ["cpp:build"],
      "options": {
        "cwd": "packages/vla-ggml",
        "command": "node ci/run-cpp-tests.mjs"
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "darwin-x64": {
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 60
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/vla-ggml",
        "command": "pnpm exec node ci/run-integration.mjs"
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-x64-gpu": {
          "ci": {
            "runner": "linux_ubuntu2404_x64_gpu"
          }
        },
        "linux-arm64": {
          "ci": {
            "runner": "ubuntu_2204_arm"
          }
        },
        "linux-arm64-2404": {
          "ci": {
            "runner": "ubuntu_2404_arm"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "darwin-x64": {
          "ci": {
            "runner": "macos_15_large"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64_gpu"
          }
        }
      }
    },
    "test:backend": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/vla-ggml",
        "command": "pnpm exec node ci/run-backend.mjs"
      },
      "configurations": {
        "linux-x64-gpu": {
          "ci": {
            "runner": "linux_ubuntu2404_x64_gpu"
          }
        }
      }
    },
    "test:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/vla-ggml",
        "command": "pnpm exec node ci/prepare-mobile.mjs"
      },
      "configurations": {
        "android-arm64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "ios-arm64": {
          "ci": {
            "runner": "macos_ios"
          }
        }
      },
      "metadata": {
        "mobile": {
          "devicefarmProject": "LLAMACPP_EMBED",
          "enablesPerf": true,
          "mochaTimeoutMs": 4200000,
          "perTestTimeoutMinutes": {
            "Android": 60
          },
          "perfReport": {
            "title": "VLA Mobile Performance Report",
            "merge": true
          }
        }
      }
    },
    "cache:models": {
      "executor": "nx:noop"
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "vla"
        }
      }
    }
  },
  "implicitDependencies": ["inference-addon-cpp", "lint-cpp", "qvac-addon-cmake"]
}

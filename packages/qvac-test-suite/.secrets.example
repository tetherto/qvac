# Copy to .secrets and fill in values
# Used by `act` for local GitHub Actions testing

# NPM registry tokens
NPM_TOKEN=npm_xxxxxxxxxxxx
PAT_TOKEN=ghp_xxxxxxxxxxxx

# MQTT connection
MQTT_PROTOCOL=mqtts
MQTT_HOST=your-broker.example.com
MQTT_PORT=8883
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password

# Optional: CA certificate (paste full PEM content)
MQTT_CA_CERT=-----BEGIN CERTIFICATE-----
...certificate content...
-----END CERTIFICATE-----


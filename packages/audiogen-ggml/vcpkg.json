{
  "dependencies": [
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.5.0"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "ggml-speech",
      "default-features": false
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "audiogen",
        "metal",
        "coreml"
      ],
      "platform": "osx | ios"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "audiogen",
        "vulkan",
        "opencl"
      ],
      "platform": "android"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "audiogen",
        "vulkan"
      ],
      "platform": "!(osx | ios | android)"
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA GPU acceleration",
      "supports": "!(osx | ios | android)",
      "dependencies": [
        {
          "name": "speech-cpp",
          "default-features": false,
          "features": [
            "cuda"
          ],
          "platform": "!(osx | ios | android)"
        }
      ]
    },
    "fuzz": {
      "description": "Build fuzz targets (Google FuzzTest dependencies)",
      "dependencies": [
        {
          "name": "abseil",
          "version>=": "20260526.0",
          "features": [
            "asan"
          ]
        },
        "antlr4",
        {
          "name": "fuzztest",
          "version>=": "2026-06-29",
          "features": [
            "asan"
          ]
        },
        "gtest",
        {
          "name": "re2",
          "version>=": "2025-11-05",
          "features": [
            "asan"
          ]
        }
      ]
    },
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "vulkan": {
      "description": "Enable Vulkan GPU acceleration",
      "dependencies": [
        {
          "name": "speech-cpp",
          "default-features": false,
          "features": [
            "vulkan"
          ],
          "platform": "!(osx | ios)"
        }
      ]
    },
    "webgpu": {
      "description": "Opt-in native WebGPU (Dawn). Build with AUDIOGEN_WEBGPU=ON.",
      "dependencies": [
        {
          "name": "speech-cpp",
          "default-features": false,
          "features": [
            "webgpu"
          ]
        },
        {
          "name": "dawn",
          "default-features": false
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "ggml-speech",
      "version": "2026-10-27"
    },
    {
      "name": "speech-cpp",
      "version": "2026-10-29",
      "port-version": 0
    },
    {
      "name": "dawn",
      "version": "20260410.140140"
    }
  ]
}

{
  "dependencies": [
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.3.3"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-09-02",
      "default-features": false,
      "features": [
        "audiogen",
        "metal"
      ],
      "platform": "osx | ios"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-09-02",
      "default-features": false,
      "features": [
        "audiogen",
        "vulkan",
        "opencl"
      ],
      "platform": "android"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-09-02",
      "default-features": false,
      "features": [
        "audiogen",
        "vulkan"
      ],
      "platform": "!(osx | ios | android)"
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA GPU acceleration",
      "dependencies": [
        {
          "name": "speech-cpp",
          "version>=": "2026-09-02",
          "default-features": false,
          "features": [
            "cuda"
          ],
          "platform": "!(osx | ios | android)"
        }
      ]
    },
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "vulkan": {
      "description": "Enable Vulkan GPU acceleration",
      "dependencies": [
        {
          "name": "speech-cpp",
          "version>=": "2026-09-02",
          "default-features": false,
          "features": [
            "vulkan"
          ],
          "platform": "!(osx | ios)"
        }
      ]
    }
  }
}

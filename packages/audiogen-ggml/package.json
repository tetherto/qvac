{
  "name": "@qvac/audiogen-ggml",
  "version": "0.0.1",
  "description": "Audio generation (music) addon for qvac (ggml backend, wrapping the ACE-Step engine from audiogen-cpp). Text prompt in, stereo 48kHz audio out.",
  "addon": true,
  "engines": {
    "bare": ">=1.19.0"
  },
  "scripts": {
    "build": "bare-make generate && bare-make build && bare-make install",
    "example": "bare examples/generate-music.js \"Upbeat pop rock with driving electric guitars and a catchy hook\"",
    "lint": "prettier --check \"*.js\" \"lib/*.js\" && lunte \"*.js\" \"lib/*.js\"",
    "format": "prettier --write \"*.js\" \"lib/*.js\""
  },
  "exports": {
    "./package": "./package.json",
    ".": "./index.js"
  },
  "files": [
    "binding.js",
    "index.js",
    "index.d.ts",
    "lib",
    "prebuilds",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/audiogen-ggml"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://qvac.tether.io",
  "keywords": [
    "qvac",
    "audiogen",
    "music-generation",
    "acestep",
    "ggml"
  ],
  "devDependencies": {
    "@qvac/registry-client": "^0.4.0",
    "bare-process": "^4.2.2",
    "brittle": "^3.17.0",
    "cmake-bare": "^1.7.5",
    "cmake-vcpkg": "^1.1.0",
    "lunte": "^1.8.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@qvac/error": "^0.1.0",
    "@qvac/infer-base": "^0.6.0",
    "@qvac/logging": "^0.1.0",
    "bare-fs": "^4.5.6",
    "bare-os": "^3.8.0",
    "bare-path": "^3.0.0"
  },
  "types": "index.d.ts"
}

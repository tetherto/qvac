{
  "name": "ggml-speech",
  "version-date": "2026-07-17",
  "description": "LOCAL OVERLAY (QVAC-21921): ggml-speech built from the local qvac-ext-ggml checkout (feat/QVAC-21921-acestep-ops) so the acestep custom ops (GGML_OP_SNAKE, GGML_OP_COL2IM_1D) are available. Dev-only; drop once merged into qvac-ext-ggml@speech and published.",
  "homepage": "https://github.com/tetherto/qvac-ext-ggml/tree/speech",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    {
      "name": "metal",
      "platform": "osx | ios"
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA GPU backend"
    },
    "metal": {
      "description": "Enable Metal GPU backend (macOS/iOS)"
    },
    "opencl": {
      "description": "Enable OpenCL GPU backend"
    },
    "vulkan": {
      "description": "Enable Vulkan GPU backend"
    }
  }
}

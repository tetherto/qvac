{
  "name": "@qvac/audiogen-ggml",
  "root": "packages/audiogen-ggml",
  "tags": [
    "ci:addons"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/audiogen-ggml",
        "command": "pnpm run lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/audiogen-ggml",
        "command": "pnpm run test:dts"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/audiogen-ggml",
        "command": "pnpm run test:unit"
      }
    },
    "verify:generated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/audiogen-ggml",
        "command": "pnpm run check:generated"
      }
    },
    "ci:system": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^ci:system"
      ],
      "options": {
        "cwd": "packages/audiogen-ggml",
        "parallel": false,
        "forwardAllArgs": false,
        "commands": [
          "echo no system packages"
        ]
      },
      "configurations": {
        "linux-arm64": {
          "commands": [
            "dpkg -s pkg-config libx11-dev libxcb1-dev libxkbcommon-dev libgomp1 libomp5 libblas3 mesa-vulkan-drivers >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y pkg-config libx11-dev libxcb1-dev libxkbcommon-dev libgomp1 libomp5 libblas3 mesa-vulkan-drivers)"
          ]
        },
        "android-arm64": {
          "commands": [
            "dpkg -s pkg-config libx11-dev libxcb1-dev libxkbcommon-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y pkg-config libx11-dev libxcb1-dev libxkbcommon-dev)"
          ]
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "packages/audiogen-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm run build:ts",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make generate -D BUILD_TESTING=OFF",
            "forwardAllArgs": true
          },
          {
            "command": "pnpm exec bare-make build",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make install",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "args": "--platform=linux --arch=x64 -D ENABLE_CUDA=ON",
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-arm64": {
          "args": "--platform=linux --arch=arm64",
          "ci": {
            "runner": "ubuntu_2204_arm"
          }
        },
        "android-arm64": {
          "args": "--platform=android --arch=arm64 -D ANDROID_STL=c++_shared",
          "ci": {
            "runner": "ubuntu_2404"
          }
        },
        "ios-arm64": {
          "args": "--platform=ios --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-arm64-simulator": {
          "args": "--platform=ios --arch=arm64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-x64-simulator": {
          "args": "--platform=ios --arch=x64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-arm64": {
          "args": "--platform=darwin --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "args": "--platform=darwin --arch=x64",
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "args": "--platform=win32 --arch=x64",
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "link:platform": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/audiogen-ggml",
        "command": "pnpm run link:platform"
      }
    },
    "cpp:lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/audiogen-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "node ../../scripts/ci/cpp-lint-changed.mjs --base {args.diff-base} --generate \"pnpm exec bare-make generate -D ENABLE_VULKAN=OFF\"",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120
      }
    },
    "cpp:build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/audiogen-ggml",
        "parallel": false,
        "env": {
          "CMAKE_BUILD_PARALLEL_LEVEL": "2",
          "VCPKG_MAX_CONCURRENCY": "2"
        },
        "commands": [
          "pnpm run build:native"
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      }
    },
    "cpp:tests": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "cpp:build"
      ],
      "options": {
        "cwd": "packages/audiogen-ggml",
        "parallel": false,
        "commands": [
          "node --test scripts/__tests__/run-cpp-fuzz.test.js",
          "pnpm run fuzz:build",
          "pnpm run fuzz:run"
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/audiogen-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "node ci/integration.mjs",
            "forwardAllArgs": true
          }
        ]
      },
      "configurations": {
        "linux-x64-gpu2204": {
          "ci": {
            "runner": "linux_ubuntu2204_x64_gpu"
          }
        },
        "linux-x64-gpu": {
          "ci": {
            "runner": "linux_ubuntu2404_x64_gpu"
          }
        },
        "linux-x64-2604": {
          "args": "--set NO_GPU=true",
          "ci": {
            "runner": "ubuntu_2604"
          }
        },
        "linux-arm64": {
          "args": "--set NO_GPU=true",
          "ci": {
            "runner": "ubuntu_2404_arm"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "darwin-x64": {
          "args": "--set NO_GPU=true",
          "ci": {
            "runner": "macos_15_large"
          }
        },
        "win32-x64": {
          "args": "--set GGML_VK_VISIBLE_DEVICES=1",
          "ci": {
            "runner": "win_2025_x64_gpu"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 360,
        "secrets": [
          "GITHUB_TOKEN"
        ]
      }
    },
    "test:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/audiogen-ggml",
        "command": "node ci/prepare-mobile.mjs"
      },
      "configurations": {
        "android-arm64": {
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "ios-arm64": {
          "ci": {
            "runner": "macos_ios"
          }
        }
      },
      "metadata": {
        "mobile": {
          "devicefarmProject": "AUDIOGEN_GGML",
          "enablesPerf": false,
          "mochaTimeoutMs": 3600000,
          "waitforTimeoutMs": 600000,
          "perfReport": {
            "title": "Mobile Performance: audiogen-ggml",
            "merge": true
          }
        }
      }
    },
    "benchmark": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/audiogen-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "node ci/benchmark.mjs",
            "forwardAllArgs": true
          }
        ]
      },
      "configurations": {
        "linux-x64-gpu2204": {
          "args": "--matrix cpu-vulkan",
          "ci": {
            "runner": "linux_ubuntu2204_x64_gpu"
          }
        },
        "linux-x64-gpu": {
          "args": "--matrix cpu-vulkan",
          "ci": {
            "runner": "linux_ubuntu2404_x64_gpu"
          }
        },
        "linux-x64-2604": {
          "args": "--matrix cpu --set NO_GPU=true",
          "ci": {
            "runner": "ubuntu_2604"
          }
        },
        "linux-arm64": {
          "args": "--matrix cpu --set NO_GPU=true",
          "ci": {
            "runner": "ubuntu_2404_arm"
          }
        },
        "darwin-arm64": {
          "args": "--matrix cpu-metal",
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "darwin-x64": {
          "args": "--matrix cpu --set NO_GPU=true",
          "ci": {
            "runner": "macos_15_large"
          }
        },
        "win32-x64": {
          "args": "--matrix cpu-vulkan --set GGML_VK_VISIBLE_DEVICES=1",
          "ci": {
            "runner": "win_2025_x64_gpu"
          }
        },
        "report": {
          "commands": [
            "bash ci/benchmark-report.sh"
          ]
        }
      },
      "metadata": {
        "timeoutMinutes": 360,
        "secrets": [
          "GITHUB_TOKEN"
        ]
      }
    },
    "cache:models": {
      "executor": "nx:noop"
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "audiogen-ggml",
          "platformPackages": true,
          "nameTransform": "rename-prefix"
        }
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

{
  "name": "@qvac/audiogen-ggml",
  "root": "packages/audiogen-ggml",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "hasCppLint": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "artifactNamePrefix": "audiogen-ggml-",
          "linuxExtraPackages": "pkg-config libx11-dev libxcb1-dev libxkbcommon-dev",
          "includeVulkanSdk": true,
          "setupPythonOnWindows": true
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/audiogen-ggml"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "timeoutMinutes": 360,
          "envVarName": "GITHUB_TOKEN",
          "envSecretName": "GITHUB_TOKEN",
          "runIntegrationTests": true,
          "runRtfBenchmarks": false,
          "linuxArmApt": ["libgomp1", "libomp5", "libblas3", "mesa-vulkan-drivers"],
          "windowsVulkan": { "setSdk": true, "visibleDevices": true },
          "modelCache": [
            {
              "cacheKeySuffix": "all-dit-variants",
              "paths": "packages/audiogen-ggml/models",
              "hashFilesGlob": "packages/audiogen-ggml/scripts/download-audiogen-ggml-models.js",
              "warm": "false"
            }
          ],
          "modelEnv": { "INTEGRATION_TEST_TIMEOUT": "3600", "LD_LIBRARY_PATH": "{workspace}/{workdir}/prebuilds/{platform}-{arch}", "DYLD_LIBRARY_PATH": "{workspace}/{workdir}/prebuilds/{platform}-{arch}" },
          "modelDownloadScript": "download-models:registry:all",
          "modelDownloadSkipOnCacheHit": true,
          "rtfBenchmark": {
            "command": "node scripts/run-rtf-benchmark-matrix.js",
            "matrixEnvVar": "QVAC_AUDIOGEN_GGML_BENCHMARK_MATRIX_JSON",
            "env": {
              "QVAC_AUDIOGEN_GGML_BENCHMARK_WARMUP_RUNS": "1",
              "QVAC_AUDIOGEN_GGML_BENCHMARK_RUNS": "3",
              "QVAC_AUDIOGEN_GGML_BENCHMARK_DURATION_S": "15"
            }
          },
          "platforms": [
            {
              "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64-gpu",
              "benchmarkMatrixJson": [
                { "ditVariant": "turbo-q4", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "turbo-q8", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "sft", "useGPU": false, "backendHint": "cpu", "numWarmup": 0, "numRuns": 1 },
                { "ditVariant": "turbo-q4", "useGPU": true, "backendHint": "vulkan" },
                { "ditVariant": "turbo-q8", "useGPU": true, "backendHint": "vulkan" },
                { "ditVariant": "sft", "useGPU": true, "backendHint": "vulkan", "numRuns": 2 }
              ]
            },
            {
              "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64-gpu",
              "benchmarkMatrixJson": [
                { "ditVariant": "turbo-q4", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "turbo-q8", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "sft", "useGPU": false, "backendHint": "cpu", "numWarmup": 0, "numRuns": 1 },
                { "ditVariant": "turbo-q4", "useGPU": true, "backendHint": "vulkan" },
                { "ditVariant": "turbo-q8", "useGPU": true, "backendHint": "vulkan" },
                { "ditVariant": "sft", "useGPU": true, "backendHint": "vulkan", "numRuns": 2 }
              ]
            },
            {
              "os": "ubuntu-26.04", "platform": "linux", "arch": "x64", "noGpu": true,
              "benchmarkMatrixJson": [
                { "ditVariant": "turbo-q4", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "turbo-q8", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "sft", "useGPU": false, "backendHint": "cpu", "numWarmup": 0, "numRuns": 1 }
              ]
            },
            {
              "os": "ubuntu-24.04-arm", "platform": "linux", "arch": "arm64", "noGpu": true,
              "benchmarkMatrixJson": [
                { "ditVariant": "turbo-q4", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "turbo-q8", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "sft", "useGPU": false, "backendHint": "cpu", "numWarmup": 0, "numRuns": 1 }
              ]
            },
            {
              "os": "macos-26", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu",
              "benchmarkMatrixJson": [
                { "ditVariant": "turbo-q4", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "turbo-q8", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "sft", "useGPU": false, "backendHint": "cpu", "numWarmup": 0, "numRuns": 1 },
                { "ditVariant": "turbo-q4", "useGPU": true, "backendHint": "metal" },
                { "ditVariant": "turbo-q8", "useGPU": true, "backendHint": "metal" },
                { "ditVariant": "sft", "useGPU": true, "backendHint": "metal", "numRuns": 2 }
              ]
            },
            {
              "os": "macos-15-large", "platform": "darwin", "arch": "x64", "noGpu": true,
              "benchmarkMatrixJson": [
                { "ditVariant": "turbo-q4", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "turbo-q8", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "sft", "useGPU": false, "backendHint": "cpu", "numWarmup": 0, "numRuns": 1 }
              ]
            },
            {
              "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64-gpu",
              "benchmarkMatrixJson": [
                { "ditVariant": "turbo-q4", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "turbo-q8", "useGPU": false, "backendHint": "cpu" },
                { "ditVariant": "sft", "useGPU": false, "backendHint": "cpu", "numWarmup": 0, "numRuns": 1 },
                { "ditVariant": "turbo-q4", "useGPU": true, "backendHint": "vulkan" },
                { "ditVariant": "turbo-q8", "useGPU": true, "backendHint": "vulkan" },
                { "ditVariant": "sft", "useGPU": true, "backendHint": "vulkan", "numRuns": 2 }
              ]
            }
          ]
        }
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'carve-out: routed to cpp-test-coverage-audiogen-ggml.yml'",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "carveOut": true
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/audiogen-ggml"
      }
    },
    "on-merge": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-merge-nx.yml'",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "buildStep": "none",
          "nameTransform": "rename-prefix",
          "repoName": "audiogen-ggml",
          "testGateMode": "none"
        }
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

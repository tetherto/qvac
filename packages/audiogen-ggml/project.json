{
  "name": "@qvac/audiogen-ggml",
  "root": "packages/audiogen-ggml",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "hasCppLint": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "artifactNamePrefix": "audiogen-ggml-",
          "linuxExtraPackages": "pkg-config libx11-dev libxcb1-dev libxkbcommon-dev",
          "includeVulkanSdk": true
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/audiogen-ggml"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "envVarName": "GITHUB_TOKEN",
          "envSecretName": "PAT_TOKEN",
          "runIntegrationTests": true,
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64-gpu" },
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64-gpu" },
            { "os": "ubuntu-26.04", "platform": "linux", "arch": "x64" },
            { "os": "ubuntu-24.04-arm", "platform": "linux", "arch": "arm64" },
            { "os": "macos-26", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu" },
            { "os": "macos-15-large", "platform": "darwin", "arch": "x64" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64-gpu" }
          ]
        }
      }
    },
    "test:integration-mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:mobile:validate || true",
        "cwd": "packages/audiogen-ggml",
        "ci": {
          "npmName": "@qvac/audiogen-ggml",
          "prebuildArtifactPrefix": "audiogen-ggml-",
          "deviceFarmProjectArnPrimary": "AWS_DEVICE_FARM_PROJECT_ARN_AUDIOGEN_GGML",
          "deviceFarmProjectArnFallback": "AWS_DEVICE_FARM_PROJECT_ARN_ONNX_TTS",
          "iosDevicePoolArnPrimary": "IOS_DEVICE_POOL_ARN_AUDIOGEN_GGML",
          "iosDevicePoolArnFallback": "IOS_DEVICE_POOL_ARN_ONNX_TTS",
          "enablesPerf": false
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/audiogen-ggml"
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

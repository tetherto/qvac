{
  "name": "@qvac/asr-ggml",
  "root": "packages/asr-ggml",
  "tags": [
    "ci:contract"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          "npm install --ignore-scripts --no-audit --no-fund",
          "npm run lint"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          "npm install --ignore-scripts --no-audit --no-fund",
          "npm run test:dts"
        ]
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          "npm install --ignore-scripts --no-audit --no-fund",
          "npm run test:unit"
        ]
      }
    },
    "verify:generated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          "npm install --ignore-scripts --no-audit --no-fund",
          "npm run check:generated"
        ]
      }
    },
    "ci:system": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^ci:system"
      ],
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "forwardAllArgs": false,
        "commands": [
          "echo no system packages"
        ]
      },
      "configurations": {
        "linux-arm64": {
          "commands": [
            "dpkg -s pkg-config libx11-dev libxcb1-dev libxkbcommon-dev libopenblas-dev liblapack-dev libfftw3-dev mesa-vulkan-drivers >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y pkg-config libx11-dev libxcb1-dev libxkbcommon-dev libopenblas-dev liblapack-dev libfftw3-dev mesa-vulkan-drivers)"
          ]
        },
        "android-arm64": {
          "commands": [
            "dpkg -s pkg-config libx11-dev libxcb1-dev libxkbcommon-dev libopenblas-dev liblapack-dev libfftw3-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y pkg-config libx11-dev libxcb1-dev libxkbcommon-dev libopenblas-dev liblapack-dev libfftw3-dev)"
          ]
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "npm install --ignore-scripts --no-audit --no-fund",
            "forwardAllArgs": false
          },
          {
            "command": "npm run build:ts",
            "forwardAllArgs": false
          },
          {
            "command": "npx --no-install bare-make generate -D BUILD_TESTING=OFF",
            "forwardAllArgs": true
          },
          {
            "command": "npx --no-install bare-make build",
            "forwardAllArgs": false
          },
          {
            "command": "npx --no-install bare-make install",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "args": "--platform=linux --arch=x64 -D ASR_CUDA=ON",
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-arm64": {
          "args": "--platform=linux --arch=arm64",
          "ci": {
            "runner": "ubuntu_2204_arm"
          }
        },
        "android-arm64": {
          "args": "--platform=android --arch=arm64 -D ANDROID_STL=c++_shared",
          "ci": {
            "runner": "ubuntu_2404"
          }
        },
        "ios-arm64": {
          "args": "--platform=ios --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-arm64-simulator": {
          "args": "--platform=ios --arch=arm64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-x64-simulator": {
          "args": "--platform=ios --arch=x64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-arm64": {
          "args": "--platform=darwin --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "args": "--platform=darwin --arch=x64",
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "args": "--platform=win32 --arch=x64",
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "link:platform": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/asr-ggml",
        "command": "npm run link:platform"
      }
    },
    "cpp:lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "node ../../scripts/ci/cpp-lint-changed.mjs --base {args.diff-base} --generate \"npm install --ignore-scripts --no-audit --no-fund && npx --no-install bare-make generate -D ENABLE_VULKAN=OFF\"",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120
      }
    },
    "cpp:build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "env": {
          "CMAKE_BUILD_PARALLEL_LEVEL": "2",
          "VCPKG_MAX_CONCURRENCY": "2"
        },
        "commands": [
          "npm install --ignore-scripts --no-audit --no-fund",
          "npm run coverage:cpp:build"
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      }
    },
    "cpp:tests": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "cpp:build"
      ],
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          "ASAN_OPTIONS=alloc_dealloc_mismatch=0:detect_leaks=0:abort_on_error=1 LSAN_OPTIONS=suppressions=$PWD/.lsan-suppressions.txt QVAC_TEST_GGUF=$PWD/models/sortformer-4spk-v1.q4_0.gguf npm run test:cpp:run",
          "npm run coverage:cpp:report",
          "npm run fuzz:build",
          "npm run fuzz:run"
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "node ci/integration.mjs",
            "forwardAllArgs": true
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "args": "--no-gpu",
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-x64-gpu2204": {
          "args": "--cuda-lib /usr/local/cuda/lib64",
          "ci": {
            "runner": "linux_ubuntu2204_x64_gpu"
          }
        },
        "linux-x64-gpu": {
          "args": "--vulkan-smoke",
          "ci": {
            "runner": "linux_ubuntu2404_x64_gpu"
          }
        },
        "linux-x64-2604": {
          "args": "--no-gpu",
          "ci": {
            "runner": "ubuntu_2604"
          }
        },
        "linux-arm64": {
          "args": "--no-gpu",
          "ci": {
            "runner": "ubuntu_2404_arm"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "darwin-x64": {
          "args": "--no-gpu --whisper-gpu",
          "ci": {
            "runner": "macos_15_large"
          }
        },
        "win32-x64": {
          "args": "--set GGML_VK_VISIBLE_DEVICES=1",
          "ci": {
            "runner": "win_2025_x64_gpu"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120,
        "secrets": [
          "GITHUB_TOKEN"
        ]
      }
    },
    "test:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/asr-ggml",
        "command": "node ci/prepare-mobile.mjs"
      },
      "configurations": {
        "android-arm64": {
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "ios-arm64": {
          "ci": {
            "runner": "macos_ios"
          }
        }
      },
      "metadata": {
        "mobile": {
          "devicefarmProject": "ASR_GGML",
          "enablesPerf": true,
          "mochaTimeoutMs": 3300000,
          "waitforTimeoutMs": 600000,
          "perTestTimeoutMinutes": {
            "Android": 45,
            "iOS": 45
          },
          "perfReport": {
            "title": "Mobile Performance: asr-ggml",
            "merge": true
          }
        },
        "timeoutMinutes": 210
      }
    },
    "benchmark": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/asr-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "node ci/benchmark.mjs",
            "forwardAllArgs": true
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "args": "--config linux-x64 --suite rtf --no-gpu --set QVAC_ASR_GGML_BENCHMARK_DEVICE=qvac-ubuntu2204-x64 --set QVAC_ASR_GGML_BENCHMARK_RUNNER=qvac-ubuntu2204-x64",
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-x64-gpu2204": {
          "args": "--config linux-x64-gpu2204 --suite rtf --set QVAC_ASR_GGML_BENCHMARK_DEVICE=qvac-ubuntu2204-x64-gpu --set QVAC_ASR_GGML_BENCHMARK_RUNNER=qvac-ubuntu2204-x64-gpu",
          "ci": {
            "runner": "linux_ubuntu2204_x64_gpu"
          }
        },
        "linux-x64-gpu": {
          "args": "--config linux-x64-gpu --suite rtf --set QVAC_ASR_GGML_BENCHMARK_DEVICE=qvac-ubuntu2404-x64-gpu --set QVAC_ASR_GGML_BENCHMARK_RUNNER=qvac-ubuntu2404-x64-gpu",
          "ci": {
            "runner": "linux_ubuntu2404_x64_gpu"
          }
        },
        "linux-x64-2604": {
          "args": "--config linux-x64-2604 --suite rtf --no-gpu --set QVAC_ASR_GGML_BENCHMARK_DEVICE=ubuntu-26.04 --set QVAC_ASR_GGML_BENCHMARK_RUNNER=ubuntu-26.04",
          "ci": {
            "runner": "ubuntu_2604"
          }
        },
        "linux-arm64": {
          "args": "--config linux-arm64 --suite rtf --no-gpu --set QVAC_ASR_GGML_BENCHMARK_DEVICE=ubuntu-24.04-arm --set QVAC_ASR_GGML_BENCHMARK_RUNNER=ubuntu-24.04-arm",
          "ci": {
            "runner": "ubuntu_2404_arm"
          }
        },
        "darwin-arm64": {
          "args": "--config darwin-arm64 --suite rtf --set QVAC_ASR_GGML_BENCHMARK_DEVICE=qvac-macos26-arm64-gpu --set QVAC_ASR_GGML_BENCHMARK_RUNNER=qvac-macos26-arm64-gpu",
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "darwin-x64": {
          "args": "--config darwin-x64 --suite rtf --no-gpu --set QVAC_ASR_GGML_BENCHMARK_DEVICE=macos-15-large --set QVAC_ASR_GGML_BENCHMARK_RUNNER=macos-15-large",
          "ci": {
            "runner": "macos_15_large"
          }
        },
        "win32-x64": {
          "args": "--config win32-x64 --suite rtf --set GGML_VK_VISIBLE_DEVICES=1 --set QVAC_ASR_GGML_BENCHMARK_DEVICE=qvac-win25-x64-gpu --set QVAC_ASR_GGML_BENCHMARK_RUNNER=qvac-win25-x64-gpu",
          "ci": {
            "runner": "win_2025_x64_gpu"
          }
        },
        "linux-x64-accuracy": {
          "args": "--suite accuracy",
          "ci": {
            "runner": "ubuntu_2404"
          }
        },
        "report": {
          "commands": [
            "node ci/benchmark-report.mjs"
          ]
        }
      },
      "metadata": {
        "timeoutMinutes": 1440,
        "secrets": [
          "GITHUB_TOKEN",
          "MODEL_S3_BUCKET"
        ]
      }
    },
    "cache:models": {
      "executor": "nx:noop"
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "asr-ggml",
          "platformPackages": true,
          "nameTransform": "rename-prefix"
        }
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

{
  "name": "asr-ggml",
  "version": "0.1.0",
  "dependencies": [
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.3.3"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-09-03",
      "default-features": false,
      "features": [
        "whisper",
        "parakeet",
        "coreml",
        "metal"
      ],
      "platform": "osx | ios"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-09-03",
      "default-features": false,
      "features": [
        "whisper",
        "parakeet",
        "vulkan",
        "opencl"
      ],
      "platform": "android"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-09-03",
      "default-features": false,
      "features": [
        "whisper",
        "parakeet",
        "vulkan"
      ],
      "platform": "!(osx | ios | android)"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable the CUDA GPU backend for both engines (Linux / Windows on NVIDIA). Off by default; building it needs nvcc on the build host, so opt in with `bare-make generate -D ASR_CUDA=ON`. At runtime CUDA engages only where the NVIDIA driver and the CUDA 13 runtime libraries (cudart, cuBLAS) both resolve; hosts without them skip the CUDA backend and fall back to Vulkan or CPU.",
      "supports": "!(osx | ios | android)",
      "dependencies": [
        {
          "name": "speech-cpp",
          "version>=": "2026-09-03",
          "default-features": false,
          "features": [
            "cuda"
          ],
          "platform": "!(osx | ios | android)"
        }
      ]
    },
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}

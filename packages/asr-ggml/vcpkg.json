{
  "name": "asr-ggml",
  "version": "0.1.0",
  "dependencies": [
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.5.0"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "ggml-speech",
      "default-features": false
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "whisper",
        "parakeet",
        "coreml",
        "metal"
      ],
      "platform": "osx | ios"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "whisper",
        "parakeet",
        "vulkan",
        "opencl"
      ],
      "platform": "android"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "whisper",
        "parakeet",
        "vulkan"
      ],
      "platform": "!(osx | ios | android)"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable the CUDA GPU backend for both engines (Linux / Windows on NVIDIA). Off by default; the published linux-x64 prebuild enables it, and building it elsewhere needs nvcc on the build host, so opt in with `bare-make generate -D ASR_CUDA=ON`. At runtime CUDA engages only where the NVIDIA driver and the CUDA 13 runtime libraries (cudart, cuBLAS) both resolve; hosts without them skip the CUDA backend and fall back to Vulkan or CPU.",
      "supports": "!(osx | ios | android)",
      "dependencies": [
        {
          "name": "speech-cpp",
          "default-features": false,
          "features": [
            "cuda"
          ],
          "platform": "!(osx | ios | android)"
        }
      ]
    },
    "fuzz": {
      "description": "Build fuzz targets (Google FuzzTest dependencies)",
      "dependencies": [
        {
          "name": "abseil",
          "version>=": "20260526.0",
          "features": [
            "asan"
          ]
        },
        "antlr4",
        {
          "name": "fuzztest",
          "version>=": "2026-06-29",
          "features": [
            "asan"
          ]
        },
        "gtest",
        {
          "name": "re2",
          "version>=": "2025-11-05",
          "features": [
            "asan"
          ]
        }
      ]
    },
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "webgpu": {
      "description": "Opt-in native WebGPU (Dawn) for the ASR engines. Build with ASR_WEBGPU=ON.",
      "dependencies": [
        {
          "name": "speech-cpp",
          "default-features": false,
          "features": [
            "webgpu"
          ]
        },
        {
          "name": "dawn",
          "default-features": false
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "ggml-speech",
      "version": "2026-10-27"
    },
    {
      "name": "speech-cpp",
      "version": "2026-10-30",
      "port-version": 1
    },
    {
      "name": "dawn",
      "version": "20260410.140140"
    }
  ]
}

{
  "name": "@qvac/ocr-ggml",
  "root": "packages/ocr-ggml",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/ocr-ggml",
        "ci": {
          "artifactNamePrefix": "ggml-ocr-",
          "includeVulkanSdk": true
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/ocr-ggml"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/ocr-ggml",
        "ci": {
          "envVarName": "QASE_API_TOKEN",
          "envSecretName": "QASE_API_TOKEN",
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64" },
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64-gpu" },
            { "os": "ubuntu-24.04-arm", "platform": "linux", "arch": "arm64", "runner": "ubuntu-24.04-arm" },
            { "os": "ubuntu-22.04-arm", "platform": "linux", "arch": "arm64", "runner": "ubuntu-22.04-arm" },
            { "os": "mac-mini-m4", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64-gpu" }
          ]
        }
      }
    },
    "test:integration-mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:mobile:validate || true",
        "cwd": "packages/ocr-ggml",
        "ci": {
          "npmName": "@qvac/ocr-ggml",
          "prebuildArtifactPrefix": "ggml-ocr-",
          "deviceFarmProjectArnPrimary": "AWS_DEVICE_FARM_PROJECT_ARN_OCR_FASTTEXT",
          "androidDevicePoolArnPrimary": "ANDROID_DEVICE_POOL_ARN_OCR_FASTTEXT",
          "iosDevicePoolArnPrimary": "IOS_DEVICE_POOL_ARN_OCR_FASTTEXT",
          "enablesPerf": true
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/ocr-ggml"
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:cpp",
        "cwd": "packages/ocr-ggml"
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

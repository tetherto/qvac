{
  "name": "qvac-lib-infer-ocr-ggml",
  "version": "0.1.0",
  "dependencies": [
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "jpeg",
        "png",
        "quirc",
        "tiff",
        "webp"
      ]
    },
    {
      "name": "opencl",
      "platform": "android"
    },
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.4.0"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    }
  ],
  "features": {
    "tests": {
      "description": "Build tests",
      "dependencies": [
        "gtest"
      ]
    },
    "fuzz": {
      "description": "Build fuzz targets (Google FuzzTest dependencies)",
      "dependencies": [
        {
          "name": "abseil",
          "version>=": "20260526.0",
          "features": [
            "asan"
          ]
        },
        "antlr4",
        {
          "name": "fuzztest",
          "version>=": "2026-06-29",
          "features": [
            "asan"
          ]
        },
        "gtest",
        {
          "name": "re2",
          "version>=": "2025-11-05",
          "features": [
            "asan"
          ]
        }
      ]
    }
  }
}

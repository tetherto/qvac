{
  "extends": "../tsconfig.json",
  "include": ["./**/*", "../src/**/*"],
  "exclude": [
    "../node_modules",
    "../dist",
    "./dist",
    "../src/db/hyperspec/**/*.js",
    "../src/db/hyperspec/**/*.json"
  ],
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "./dist",
    "rootDir": "..",
    "declaration": false,
    "declarationMap": false
  }
}

{
  "name": "@qvac/rag",
  "root": "packages/rag",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rag",
        "parallel": false,
        "commands": ["pnpm run format", "pnpm run lint"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rag",
        "command": "pnpm run typecheck"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rag",
        "command": "pnpm run build"
      },
      "dependsOn": []
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rag",
        "command": "pnpm run test:unit"
      },
      "dependsOn": ["build"],
      "metadata": {
        "sources": ["npm"],
        "setup": ["bare"]
      }
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "rag",
          "releaseGuard": true
        }
      }
    }
  }
}

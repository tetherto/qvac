{
  "name": "@qvac/bci-whispercpp",
  "root": "packages/bci-whispercpp",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/bci-whispercpp",
        "ci": {
          "hasCppLint": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/bci-whispercpp",
        "ci": {
          "artifactNamePrefix": "bci-whispercpp-",
          "linuxExtraPackages": "libopenblas-dev liblapack-dev libfftw3-dev",
          "macBrewPackages": "openblas lapack fftw",
          "includeVulkanSdk": true,
          "extraCmakeDefines": "-D WHISPER_USE_CUDA=OFF -D WHISPER_USE_OPENVINO=OFF",
          "platformCmakeDefines": "darwin: -D WHISPER_USE_METAL=ON\nios: -D WHISPER_USE_METAL=ON\nlinux: -D WHISPER_USE_METAL=OFF\nandroid: -D WHISPER_USE_METAL=OFF\nwin32: -D WHISPER_USE_METAL=OFF\n"
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/bci-whispercpp"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/bci-whispercpp",
        "ci": {
          "envVarName": "GITHUB_TOKEN",
          "envSecretName": "PAT_TOKEN",
          "runIntegrationTests": true,
          "runRtfBenchmarks": false,
          "rtfBenchmark": {
            "command": "node scripts/run-rtf-benchmark-matrix.js",
            "matrixEnvVar": "QVAC_BCI_BENCHMARK_MATRIX_JSON",
            "comboGroups": [
              [{}]
            ]
          },
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64-gpu" },
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64-gpu" },
            { "os": "ubuntu-26.04", "platform": "linux", "arch": "x64", "noGpu": true },
            { "os": "ubuntu-24.04-arm", "platform": "linux", "arch": "arm64", "noGpu": true },
            { "os": "macos-26", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu" },
            { "os": "macos-15-large", "platform": "darwin", "arch": "x64", "noGpu": true },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64-gpu" }
          ]
        }
      }
    },
    "test:integration-mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:mobile:validate || true",
        "cwd": "packages/bci-whispercpp",
        "ci": {
          "npmName": "@qvac/bci-whispercpp",
          "prebuildArtifactPrefix": "bci-whispercpp-",
          "deviceFarmProjectArnPrimary": "AWS_DEVICE_FARM_PROJECT_ARN_WHISPERCPP",
          "iosDevicePoolArnPrimary": "IOS_DEVICE_POOL_ARN_WHISPERCPP",
          "enablesPerf": true,
          "extraPreBuildCommand": "npm run test:mobile:generate"
        }
      }
    },
    "benchmark": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'benchmark orchestrated by benchmark-performance-nx.yml'",
        "cwd": "packages/bci-whispercpp",
        "ci": {
          "aggregateScript": "scripts/perf-report/aggregate-bci-rtf.js",
          "manualDir": "packages/bci-whispercpp/benchmarks/manual-results"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/bci-whispercpp"
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:cpp",
        "cwd": "packages/bci-whispercpp",
        "ci": {
          "mode": "coverage",
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64-gpu" }
          ],
          "hasCcache": false,
          "buildOutputDir": "build/addon/tests",
          "testEnvVars": []
        }
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

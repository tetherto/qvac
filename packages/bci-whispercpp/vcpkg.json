{
  "name": "bci-whispercpp",
  "version": "0.1.0",
  "dependencies": [
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.3.3"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-08-17",
      "default-features": false,
      "features": [
        "whisper",
        "opencl",
        "vulkan"
      ],
      "platform": "android"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-08-17",
      "default-features": false,
      "features": [
        "whisper",
        "vulkan"
      ],
      "platform": "!(osx | ios | android)"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-08-17",
      "default-features": false,
      "features": [
        "whisper",
        "metal"
      ],
      "platform": "osx | ios"
    }
  ],
  "features": {
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}

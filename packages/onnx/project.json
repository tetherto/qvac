{
  "name": "@qvac/onnx",
  "root": "packages/onnx",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/onnx",
        "ci": {
          "sanityVariant": "inline",
          "hasCppLint": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/onnx",
        "ci": {
          "artifactNamePrefix": "onnx-"
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/onnx"
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:cpp",
        "cwd": "packages/onnx"
      }
    },
    "on-merge": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-merge-nx.yml'",
        "cwd": "packages/onnx",
        "ci": {
          "buildStep": "none",
          "nameTransform": "none",
          "repoName": "onnx",
          "testGateMode": "none"
        }
      }
    }
  },
  "implicitDependencies": [
    "lint-cpp"
  ]
}

{
  "name": "@qvac/turbovec-ggml",
  "root": "packages/turbovec-ggml",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/turbovec-ggml",
        "ci": {
          "hasCppLint": true,
          "hasTsChecks": true,
          "tsChecksMode": "dts+lint",
          "hasFabricLockstep": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/turbovec-ggml",
        "ci": {
          "artifactNamePrefix": "turbovec-ggml-"
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/turbovec-ggml",
        "ci": {
          "timeoutMinutes": 30,
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64" },
            { "os": "ubuntu-22.04-arm", "platform": "linux", "arch": "arm64", "runner": "ubuntu-22.04-arm" },
            { "os": "macos-15", "platform": "darwin", "arch": "arm64", "runner": "macos-15" },
            { "os": "macos-15-intel", "platform": "darwin", "arch": "x64", "runner": "macos-15-intel" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64" }
          ]
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/turbovec-ggml"
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:cpp",
        "cwd": "packages/turbovec-ggml",
        "ci": {
          "mode": "standard",
          "windowsVsGenerator": true,
          "platforms": [
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64" },
            { "os": "macos-15", "platform": "darwin", "arch": "arm64", "runner": "macos-15" },
            { "os": "macos-15-intel", "platform": "darwin", "arch": "x64", "runner": "macos-15-intel" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64" }
          ]
        }
      }
    },
    "on-merge": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-merge-nx.yml'",
        "cwd": "packages/turbovec-ggml",
        "ci": {
          "verifyGenerated": true,
          "nameTransform": "none",
          "repoName": "turbovec-ggml",
          "testGateMode": "none"
        }
      }
    }
  },
  "implicitDependencies": [
    "lint-cpp",
    "qvac-addon-cmake"
  ]
}

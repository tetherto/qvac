{
  "name": "@qvac/inference",
  "version": "0.18.2",
  "description": "Bare-only in-process core of the QVAC SDK. Runs inference directly on the Bare runtime with explicit plugin assembly and no RPC, worker, or subprocess layer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/inference"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://qvac.tether.io",
  "keywords": [
    "ai",
    "bare",
    "core",
    "diffusion",
    "edge-ai",
    "embeddings",
    "gguf",
    "holepunch",
    "hyperswarm",
    "inference",
    "large-language-model",
    "llama-cpp",
    "llm",
    "local",
    "local-ai",
    "ocr",
    "offline",
    "on-device",
    "p2p",
    "peer-to-peer",
    "qvac",
    "rag",
    "speech-to-text",
    "tether",
    "text-to-speech",
    "transcription",
    "translation",
    "tts",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./surface": {
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js"
    },
    "./package": "./package.json",
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./plugin-registry": {
      "types": "./dist/plugins/registry.d.ts",
      "import": "./dist/plugins/registry.js"
    },
    "./plugin-utils": {
      "types": "./dist/schemas/plugin.d.ts",
      "import": "./dist/schemas/plugin.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    },
    "./profiling": {
      "types": "./dist/profiling/index.d.ts",
      "import": "./dist/profiling/index.js"
    },
    "./models": {
      "types": "./dist/models/registry/index.d.ts",
      "import": "./dist/models/registry/index.js"
    },
    "./model-resource-profiles": {
      "types": "./dist/models/registry/resource-profiles.d.ts",
      "import": "./dist/models/registry/resource-profiles.js"
    },
    "./llamacpp-completion/plugin": {
      "types": "./dist/plugins/builtin/llamacpp-completion/plugin.d.ts",
      "import": "./dist/plugins/builtin/llamacpp-completion/plugin.js"
    },
    "./llamacpp-embedding/plugin": {
      "types": "./dist/plugins/builtin/llamacpp-embedding/plugin.d.ts",
      "import": "./dist/plugins/builtin/llamacpp-embedding/plugin.js"
    },
    "./whispercpp-transcription/plugin": {
      "types": "./dist/plugins/builtin/whispercpp-transcription/plugin.d.ts",
      "import": "./dist/plugins/builtin/whispercpp-transcription/plugin.js"
    },
    "./bci-whispercpp-transcription/plugin": {
      "types": "./dist/plugins/builtin/bci-whispercpp-transcription/plugin.d.ts",
      "import": "./dist/plugins/builtin/bci-whispercpp-transcription/plugin.js"
    },
    "./parakeet-transcription/plugin": {
      "types": "./dist/plugins/builtin/parakeet-transcription/plugin.d.ts",
      "import": "./dist/plugins/builtin/parakeet-transcription/plugin.js"
    },
    "./nmtcpp-translation/plugin": {
      "types": "./dist/plugins/builtin/nmtcpp-translation/plugin.d.ts",
      "import": "./dist/plugins/builtin/nmtcpp-translation/plugin.js"
    },
    "./tts-ggml/plugin": {
      "types": "./dist/plugins/builtin/tts-ggml/plugin.d.ts",
      "import": "./dist/plugins/builtin/tts-ggml/plugin.js"
    },
    "./ggml-ocr/plugin": {
      "types": "./dist/plugins/builtin/ggml-ocr/plugin.d.ts",
      "import": "./dist/plugins/builtin/ggml-ocr/plugin.js"
    },
    "./sdcpp-generation/plugin": {
      "types": "./dist/plugins/builtin/sdcpp-generation/plugin.d.ts",
      "import": "./dist/plugins/builtin/sdcpp-generation/plugin.js"
    },
    "./audiogen-ggml/plugin": {
      "types": "./dist/plugins/builtin/audiogen-ggml/plugin.d.ts",
      "import": "./dist/plugins/builtin/audiogen-ggml/plugin.js"
    },
    "./ggml-vla/plugin": {
      "types": "./dist/plugins/builtin/ggml-vla/plugin.d.ts",
      "import": "./dist/plugins/builtin/ggml-vla/plugin.js"
    },
    "./ggml-classification/plugin": {
      "types": "./dist/plugins/builtin/ggml-classification/plugin.d.ts",
      "import": "./dist/plugins/builtin/ggml-classification/plugin.js"
    }
  },
  "files": [
    "dist/**/*",
    "!dist/models/update-models/**",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "lint": "lunte",
    "lint:fix": "lunte --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "compile": "tsc -p tsconfig.build.json",
    "postcompile:aliases": "tsc-alias -p tsconfig.alias.json",
    "build": "npm run compile && npm run postcompile:aliases",
    "prepare": "npm run build",
    "build:test": "tsc -p test/tsconfig.build.json && tsc-alias -p test/tsconfig.alias.json",
    "test": "npm run build:test && brittle-bare 'test/dist/test/**/*.test.js'",
    "test:bare": "npm run test",
    "check-models": "bare ./dist/models/update-models/index.js --check",
    "update-models": "bare ./dist/models/update-models/index.js && prettier --write src/models/registry/models.ts src/models/registry/resource-profiles.ts"
  },
  "engines": {
    "bare": "^1.30.3"
  },
  "dependencies": {
    "@qvac/error": "^0.1.1",
    "@qvac/logging": "^0.1.1",
    "@qvac/rag": "^0.8.0",
    "@qvac/registry-client": "^0.6.1",
    "bare-abort-controller": "^1.1.2",
    "bare-buffer": "^3.6.2",
    "bare-cpu-info": "0.1.1",
    "bare-crypto": "^1.15.3",
    "bare-env": "^3.0.1",
    "bare-fs": "^4.7.4",
    "bare-gpu-info": "0.1.1",
    "bare-http1": "^4.5.9",
    "bare-https": "^3.0.0",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-rpc": "^1.3.8",
    "bare-stream": "^2.13.3",
    "bare-url": "^2.4.5",
    "bare-zlib": "^1.4.0",
    "compact-encoding": "^3.3.0",
    "corestore": "^7.11.0",
    "fast-safe-stringify": "2.1.1",
    "hyperdrive": "^13.3.3",
    "hyperswarm": "^4.17.0",
    "semver": "^7.8.5",
    "tar-stream": "^3.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qvac/asr-ggml": "^0.3.1",
    "@qvac/audiogen-ggml": "^0.3.1",
    "@qvac/bci-whispercpp": "^0.8.0",
    "@qvac/classification-ggml": "^0.22.0",
    "@qvac/decoder-audio": "^0.5.0",
    "@qvac/diffusion-cpp": "^0.21.0",
    "@qvac/embed-llamacpp": "^0.36.0",
    "@qvac/langdetect-text": "^0.1.2",
    "@qvac/llm-llamacpp": "^0.47.0",
    "@qvac/ocr-ggml": "^0.20.0",
    "@qvac/translation-nmtcpp": "^0.12.0",
    "@qvac/tts-ggml": "^0.7.4",
    "@qvac/vla-ggml": "^0.23.0"
  },

{
  "extends": "../tsconfig.json",
  "include": ["./*.test.ts", "../../src/types/**/*"],
  "exclude": ["../dist", "../../node_modules"],
  "compilerOptions": {
    "outDir": "../dist",
    "rootDir": "../..",
    "noEmit": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "tsc-alias": {
    "resolveFullPaths": true
  }
}

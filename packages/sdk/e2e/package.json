{
  "name": "sdk-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/tests/electron/main.js",
  "description": "SDK tests using QVAC test framework",
  "scripts": {
    "prepare:sdk": "cd .. && (bun i && bun run build); cd e2e",
    "build": "npm run clean && tsc",
    "bundle:sdk": "node scripts/bundle-sdk.mjs",
    "install:build": "npm install --install-links && npm run build",
    "install:build:sdk": "npm run prepare:sdk && npm run clean:sdk-snapshot && npm run reconcile:inference && npm run install:build && npm run bundle:sdk && npm run unpin:consumer-inference",
    "install:build:full": "node scripts/build-local-inference.mjs",
    "pin:consumer-inference": "node scripts/pin-consumer-inference.mjs",
    "unpin:consumer-inference": "node scripts/pin-consumer-inference.mjs --clear",
    "reconcile:inference": "node scripts/reconcile-e2e-inference.mjs",
    "package:electron": "electron-forge package",
    "package:snap": "node scripts/package-snap.mjs",
    "test:snap:refresh": "node scripts/run-snap-refresh-test.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:build": "npm run unpin:consumer-inference && rm -rf dist build out qvac .sdk-e2e snap/dist snap/electron-dist snap/parts snap/prime snap/stage",
    "clean:config": "rm -rf qvac.config.json qvac.config.e2e.generated.json",
    "clean:cache": "rm -rf .qvac-cache .qvac-worker-backup rag-hyperdb rag-turbovec",
    "clean:dependencies": "rm -rf node_modules package-lock.json ../node_modules ../dist ../bun.lock ../package-lock.json ../../inference/node_modules ../../inference/dist ../../inference/bun.lock ../../inference/package-lock.json",
    "clean:all": "npm run clean:build && npm run clean:config && npm run clean:cache && npm run clean:dependencies",
    "clean:sdk-snapshot": "rm -rf node_modules/@qvac/sdk build/consumers/ios/node_modules/@qvac/sdk build/consumers/android/node_modules/@qvac/sdk",
    "consumer:desktop:run": "qvac-test run:consumer:desktop",
    "consumer:electron:run": "qvac-test run:consumer:electron"
  },
  "dependencies": {
    "@qvac/sdk": "file:..",
    "@qvac/test-suite": "^0.11.0",
    "custom-calibration-plugin": "file:./fixtures/calibration-plugin",
    "custom-echo-plugin": "file:./fixtures/echo-plugin",
    "mqtt": "^5.14.1",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.14.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-base": "^7.11.2",
    "electron": "^42.4.1",
    "typescript": "^5.9.3"
  }
}

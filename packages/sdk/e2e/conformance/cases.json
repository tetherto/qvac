{
  "description": "Language-neutral cross-client conformance corpus. Both the JS runner (run.mjs) and the Python runner (packages/sdk-python/tests/test_conformance.py) execute these identical cases against a locally-built worker and assert the same expectations, so the two clients cannot drift on the covered behaviour. `model` is the constant name each client resolves from its own registry (qvac.models / @qvac/sdk). Deterministic: greedy + fixed seed.",
  "cases": [
    {
      "id": "completion-arithmetic-2plus2",
      "category": "completion",
      "model": "LLAMA_3_2_1B_INST_Q4_0",
      "modelType": "llamacpp-completion",
      "params": {
        "history": [{ "role": "user", "content": "What is 2+2? Answer with only the number." }],
        "generationParams": { "temp": 0, "seed": 42 }
      },
      "expect": { "kind": "contains", "value": "4" }
    },
    {
      "id": "completion-arithmetic-5plus5",
      "category": "completion",
      "model": "LLAMA_3_2_1B_INST_Q4_0",
      "modelType": "llamacpp-completion",
      "params": {
        "history": [{ "role": "user", "content": "What is 5+5? Answer with just the number." }],
        "generationParams": { "temp": 0, "seed": 42 }
      },
      "expect": { "kind": "contains", "value": "10" }
    },
    {
      "id": "completion-multi-turn-recall",
      "category": "completion",
      "model": "LLAMA_3_2_1B_INST_Q4_0",
      "modelType": "llamacpp-completion",
      "params": {
        "history": [
          { "role": "user", "content": "Remember this number: 42." },
          { "role": "assistant", "content": "I'll remember that the number is 42." },
          {
            "role": "user",
            "content": "What number did I tell you to remember? Answer with just the number."
          }
        ],
        "generationParams": { "temp": 0, "seed": 42 }
      },
      "expect": { "kind": "contains", "value": "42" }
    },
    {
      "id": "translation-llm-autodetect",
      "category": "translate",
      "model": "LLAMA_3_2_1B_INST_Q4_0",
      "modelType": "llamacpp-completion",
      "params": {
        "text": "Bonjour, comment allez-vous aujourd'hui?",
        "to": "en"
      },
      "expect": { "kind": "nonempty" }
    }
  ]
}

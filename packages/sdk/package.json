    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://qvac.tether.io",
  "keywords": [
    "ai",
    "bare",
    "cross-platform",
    "deep-learning",
    "diffusion",
    "edge-ai",
    "embeddings",
    "expo",
    "gguf",
    "gpu",
    "holepunch",
    "hyperswarm",
    "image-generation",
    "inference",
    "large-language-model",
    "llama-cpp",
    "llm",
    "local",
    "local-ai",
    "machine-learning",
    "ml",
    "model-registry",
    "node",
    "ocr",
    "offline",
    "on-device",
    "p2p",
    "peer-to-peer",
    "private-ai",
    "qvac",
    "rag",
    "react-native",
    "sdk",
    "self-hosted",
    "speech-to-text",
    "stt",
    "tether",
    "text-to-speech",
    "transcription",
    "translation",
    "tts",
    "typescript",
    "whisper"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    },
    "./package": "./package.json",
    "./dist/src/worker/index.js": {
      "import": "./dist/src/worker/index.js",
      "require": "./dist/src/worker/index.js"
    },
    "./dist/server/worker.js": {
      "import": "./dist/src/worker/legacy-worker-entry.js"
    },
    "./llamacpp-completion/plugin": {
      "types": "./dist/src/worker/plugins/llamacpp-completion.d.ts",
      "import": "./dist/src/worker/plugins/llamacpp-completion.js"
    },
    "./llamacpp-embedding/plugin": {
      "types": "./dist/src/worker/plugins/llamacpp-embedding.d.ts",
      "import": "./dist/src/worker/plugins/llamacpp-embedding.js"
    },
    "./whispercpp-transcription/plugin": {
      "types": "./dist/src/worker/plugins/whispercpp-transcription.d.ts",
      "import": "./dist/src/worker/plugins/whispercpp-transcription.js"
    },
    "./bci-whispercpp-transcription/plugin": {
      "types": "./dist/src/worker/plugins/bci-whispercpp-transcription.d.ts",
      "import": "./dist/src/worker/plugins/bci-whispercpp-transcription.js"
    },
    "./parakeet-transcription/plugin": {
      "types": "./dist/src/worker/plugins/parakeet-transcription.d.ts",
      "import": "./dist/src/worker/plugins/parakeet-transcription.js"
    },
    "./nmtcpp-translation/plugin": {
      "types": "./dist/src/worker/plugins/nmtcpp-translation.d.ts",
      "import": "./dist/src/worker/plugins/nmtcpp-translation.js"
    },
    "./tts-ggml/plugin": {
      "types": "./dist/src/worker/plugins/tts-ggml.d.ts",
      "import": "./dist/src/worker/plugins/tts-ggml.js"
    },
    "./onnx-tts/plugin": {
      "types": "./dist/src/worker/plugins/tts-ggml.d.ts",
      "import": "./dist/src/worker/plugins/tts-ggml.js"
    },
    "./ggml-ocr/plugin": {
      "types": "./dist/src/worker/plugins/ggml-ocr.d.ts",
      "import": "./dist/src/worker/plugins/ggml-ocr.js"
    },
    "./sdcpp-generation/plugin": {
      "types": "./dist/src/worker/plugins/sdcpp-generation.d.ts",
      "import": "./dist/src/worker/plugins/sdcpp-generation.js"
    },
    "./audiogen-ggml/plugin": {
      "types": "./dist/src/worker/plugins/audiogen-ggml.d.ts",
      "import": "./dist/src/worker/plugins/audiogen-ggml.js"
    },
    "./ggml-vla/plugin": {
      "types": "./dist/src/worker/plugins/ggml-vla.d.ts",
      "import": "./dist/src/worker/plugins/ggml-vla.js"
    },
    "./ggml-classification/plugin": {
      "types": "./dist/src/worker/plugins/ggml-classification.d.ts",
      "import": "./dist/src/worker/plugins/ggml-classification.js"
    },
    "./plugin-utils": {
      "types": "./dist/src/plugin-utils.d.ts",
      "import": "./dist/src/plugin-utils.js"
    },
    "./schemas": {
      "types": "./dist/src/schemas/public.d.ts",
      "import": "./dist/src/schemas/public.js",
      "require": "./dist/src/schemas/public.js"
    },
    "./expo-plugin": "./dist/src/expo/plugins/index.js",
    "./electron-forge": {
      "require": "./src/electron-forge/index.cjs",
      "import": "./src/electron-forge/index.cjs",
      "default": "./src/electron-forge/index.cjs"
    },
    "./worker.mobile.bundle": "./dist/worker.mobile.bundle.js",
    "./worker-lifecycle": {
      "import": "./dist/src/worker/lifecycle.js"
    },
    "./worker-core": {
      "import": "./dist/src/worker/worker-core.js"
    },
    "./plugins": {
      "import": "./dist/src/server/plugins/index.js"
    },
    "./logging": {
      "import": "./dist/src/logging/index.js"
    },
    "./commands": {
      "types": "./dist/src/commands/index.d.ts",
      "import": "./dist/src/commands/index.js"
    },
    "./models": {
      "types": "./dist/src/models/registry/index.d.ts",
      "import": "./dist/src/models/registry/index.js",
      "require": "./dist/src/models/registry/index.js"
    },
    "./pear-pre": "./dist/src/pear/pre.js"
  },
  "imports": {
    "#rpc": {
      "react-native": "./dist/src/client/rpc/expo-rpc-client.js",
      "bare": "./dist/src/client/rpc/bare-client.js",
      "default": "./dist/src/client/rpc/node-rpc-client.js"
    }
  },
  "expo": {
    "plugins": [
      "./dist/src/expo/plugins/index.js"
    ]
  },
  "files": [
    "bare-imports.json",
    "dist/**/*",
    "src/electron-forge/**/*",
    "src/expo/plugins/patches/**/*",
    "!dist/**/*.map",
    "!**/package-lock.json",
    "!**/yarn.lock",
    "!**/pnpm-lock.yaml",
    "!**/bun.lock",
    "LICENSE",
    "NOTICE",
    "docs/system-resources-support-matrix.md"
  ],
  "scripts": {
    "test:unit": "bun run scripts/run-unit-tests.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "lunte && npm run enforce-inference-peer-dependencies",
    "lint:fix": "lunte --fix",
    "enforce-inference-peer-dependencies": "bun scripts/enforce-inference-peer-dependencies.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.types.json",
    "postcompile:aliases": "tsc-alias -p tsconfig.alias.json",
    "build": "rm -rf dist && npm run lint && tsc --project tsconfig.json && npm run postcompile:aliases",
    "build:pack": "bun run build && bun pm pack --destination dist/",
    "sdk-source:workspace": "bun run ./scripts/link-workspace-inference.ts",
    "watch": "nodemon --watch src --ext ts --exec 'bun run build'",
    "bare:ensureprebuilds:llamacpp": "cp -r node_modules/@qvac/llm-llamacpp/prebuilds/android-arm64 node_modules/@qvac/llm-llamacpp/prebuilds/android-ia32 && cp -r node_modules/@qvac/llm-llamacpp/prebuilds/android-arm64 node_modules/@qvac/llm-llamacpp/prebuilds/android-arm && cp -r node_modules/@qvac/llm-llamacpp/prebuilds/android-arm64 node_modules/@qvac/llm-llamacpp/prebuilds/android-x64",
    "bare:ensureprebuilds:asr": "cp -r node_modules/@qvac/asr-ggml/prebuilds/android-arm64 node_modules/@qvac/asr-ggml/prebuilds/android-ia32 && cp -r node_modules/@qvac/asr-ggml/prebuilds/android-arm64 node_modules/@qvac/asr-ggml/prebuilds/android-arm && cp -r node_modules/@qvac/asr-ggml/prebuilds/android-arm64 node_modules/@qvac/asr-ggml/prebuilds/android-x64",
    "bare:ensureprebuilds:embeddings": "cp -r node_modules/@qvac/embed-llamacpp/prebuilds/android-arm64 node_modules/@qvac/embed-llamacpp/prebuilds/android-ia32 && cp -r node_modules/@qvac/embed-llamacpp/prebuilds/android-arm64 node_modules/@qvac/embed-llamacpp/prebuilds/android-arm && cp -r node_modules/@qvac/embed-llamacpp/prebuilds/android-arm64 node_modules/@qvac/embed-llamacpp/prebuilds/android-x64",
    "bare:ensureprebuilds": "bun run bare:ensureprebuilds:llamacpp && bun run bare:ensureprebuilds:asr && bun run bare:ensureprebuilds:embeddings",
    "prepare:husky": "bun run husky",
    "contract:export": "tsx ./scripts/export-contract.ts",
    "contract:check": "tsx ./scripts/export-contract.ts --check",
    "check:resource-collectors": "tsx ./scripts/check-resource-collectors-packaging.ts",
    "changelog:generate": "node ../../scripts/sdk/generate-changelog-sdk-pod.cjs --package=sdk && prettier --write changelog"
  },

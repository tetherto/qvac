{
  "extends": "../../tsconfig.json",
  "include": ["./**/*", "../../src/types/**/*"],
  "exclude": ["../../node_modules", "../../dist", "../../e2e", "../../examples", "../dist"],
  "compilerOptions": {
    "outDir": "../dist",
    "rootDir": "../..",

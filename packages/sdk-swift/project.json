{
  "name": "sdk-swift",
  "root": "packages/sdk-swift",
  "tags": ["ci:sdk"],
  "implicitDependencies": ["@qvac/sdk", "sdk-e2e"],
  "targets": {
    "verify:generated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk-swift",
        "command": "python3 scripts/generate.py --check"
      },
      "metadata": {
        "setup": ["python"]
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "command": "node ci/e2e.mjs swift"
      },
      "configurations": {
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu",
            "setup": ["node22"],
            "labels": {
              "dispatch:swift": ""
            }
          }
        }
      },
      "metadata": {
        "secrets": [
          "GITHUB_TOKEN",
          "MQTT_HOST",
          "MQTT_USERNAME",
          "MQTT_PASSWORD",
          "MQTT_CA_CERT",
          "MQTT_CLIENT_CERT",
          "MQTT_CLIENT_KEY"
        ],
        "timeoutMinutes": 360
      }
    },
    "test:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/sdk",
        "command": "node ci/mobile.mjs swift"
      },
      "configurations": {
        "ios-arm64": {
          "ci": {
            "runner": "macos_26"
          }
        }
      },
      "metadata": {
        "mobile": {
          "mode": "producer",
          "projectArnVar": "SDK_DEVICE_FARM_PROJECT_ARN",
          "devicePoolsVar": {
            "iOS": "SDK_IOS_DEVICE_FARM_POOLS"
          },
          "jobTimeoutMinutes": 120
        },
        "secrets": ["GITHUB_TOKEN", "MQTT_HOST", "MQTT_USERNAME", "MQTT_PASSWORD"],
        "timeoutMinutes": 280
      }
    }
  }
}

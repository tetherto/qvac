{
  "name": "@qvac/ggml-rpc-server",
  "version": "0.1.0",
  "description": "Managed ggml RPC server for QVAC LLM inference",
  "addon": true,
  "scripts": {
    "build": "npm run build:ts && npm run build:native",
    "build:native": "bare-make generate && bare-make build && bare-make install",
    "build:ts": "tsc -p tsconfig.build.json",
    "check:generated": "node scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run lint:js && npm run lint:ts && npm run test:types",
    "lint:js": "prettier --check \"**/*.{js,cjs,mjs}\" && lunte",
    "lint:ts": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:ts:fix": "eslint \"src/**/*.ts\" --fix",
    "lint-cpp": "clang-tidy -p build addon/binding.cpp",
    "format": "prettier --write \"**/*.{js,cjs,mjs}\"",
    "test": "npm run build:ts && npm run test:node",
    "test:node": "node --test test/node/*.test.cjs",
    "test:unit": "npm run test:node",
    "test:types": "npm run typecheck && npm run check:generated",
    "test:dts": "npm run test:types"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "mobile.js",
    "mobile.d.ts",
    "binding.js",
    "prebuilds",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/ggml-rpc-server"
  },
  "author": "Tether",
  "license": "Apache-2.0",
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://github.com/tetherto/qvac/tree/main/packages/ggml-rpc-server#readme",
  "devDependencies": {
    "@types/node": "^24.2.1",
    "cmake-bare": "^1.7.5",
    "cmake-vcpkg": "^1.1.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "lunte": "^1.8.4",
    "prettier": "^3.9.6",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "bare-net": "^2.3.2",
    "bare-path": "^3.0.0"
  },
  "engines": {
    "bare": ">=1.24.0",
    "node": ">=20.0.0"
  },
  "exports": {
    "./package": "./package.json",
    ".": {
      "bare": {
        "types": "./mobile.d.ts",
        "default": "./mobile.js"
      },
      "node": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "default": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    }
  },
  "types": "index.d.ts"
}

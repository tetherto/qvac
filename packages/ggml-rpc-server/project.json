{
  "name": "@qvac/ggml-rpc-server",
  "root": "packages/ggml-rpc-server",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/ggml-rpc-server",
        "ci": {
          "hasCppLint": true,
          "hasTsChecks": true,
          "tsChecksMode": "dts+lint"
        }
      },
      "inputs": [
        "default",
        "{workspaceRoot}/packages/fabric/**",
        "{workspaceRoot}/cmake/qvac-addon/**"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/ggml-rpc-server",
        "ci": {
          "includeVulkanSdk": true,
          "desktopSmokeCommand": "node scripts/smoke-packaged.cjs",
          "linuxExtraPackages": "libibverbs1"
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/ggml-rpc-server"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/ggml-rpc-server",
        "ci": {
          "timeoutMinutes": 30,
          "linuxArmApt": ["libibverbs1"],
          "windowsVulkan": { "setSdk": true, "addPath": true },
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64" },
            { "os": "ubuntu-22.04-arm", "platform": "linux", "arch": "arm64", "runner": "ubuntu-22.04-arm" },
            { "os": "macos-15", "platform": "darwin", "arch": "arm64", "runner": "macos-15" },
            { "os": "macos-15-intel", "platform": "darwin", "arch": "x64", "runner": "macos-15-intel" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64" }
          ]
        }
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:cpp",
        "cwd": "packages/ggml-rpc-server",
        "ci": {
          "mode": "standard",
          "vulkan": { "os": "ubuntu-22.04", "shell": "bash", "path": "/opt/vulkansdk/x86_64" },
          "windowsVsGenerator": true,
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64" },
            { "os": "macos-15", "platform": "darwin", "arch": "arm64", "runner": "macos-15" },
            { "os": "macos-15-intel", "platform": "darwin", "arch": "x64", "runner": "macos-15-intel" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64" }
          ]
        }
      }
    }
  }
}

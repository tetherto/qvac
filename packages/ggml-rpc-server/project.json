{
  "name": "@qvac/ggml-rpc-server",
  "root": "packages/ggml-rpc-server",
  "tags": [
    "ci:addons"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/ggml-rpc-server"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:dts",
        "cwd": "packages/ggml-rpc-server"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/ggml-rpc-server"
      }
    },
    "verify:generated": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run check:generated",
        "cwd": "packages/ggml-rpc-server"
      }
    },
    "ci:system": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^ci:system"
      ],
      "options": {
        "cwd": "packages/ggml-rpc-server",
        "parallel": false,
        "forwardAllArgs": false,
        "commands": [
          "echo no system packages"
        ]
      },
      "configurations": {
        "linux-arm64": {
          "commands": [
            "dpkg -s libibverbs1 >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs1)"
          ]
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "@qvac/fabric"
          ],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/ggml-rpc-server",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm run build:ts",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make generate",
            "forwardAllArgs": true
          },
          {
            "command": "pnpm exec bare-make build",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make install",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "commands": [
            "pnpm run build:ts",
            "pnpm exec bare-make generate --platform=linux --arch=x64",
            "pnpm exec bare-make build",
            "pnpm exec bare-make install",
            "node scripts/smoke-packaged.cjs"
          ],
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-arm64": {
          "commands": [
            "pnpm run build:ts",
            "pnpm exec bare-make generate --platform=linux --arch=arm64",
            "pnpm exec bare-make build",
            "pnpm exec bare-make install",
            "node scripts/smoke-packaged.cjs"
          ],
          "ci": {
            "runner": "ubuntu_2204_arm"
          }
        },
        "android-arm64": {
          "args": "--platform=android --arch=arm64 -D ANDROID_STL=c++_shared",
          "ci": {
            "runner": "ubuntu_2404"
          }
        },
        "ios-arm64": {
          "args": "--platform=ios --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-arm64-simulator": {
          "args": "--platform=ios --arch=arm64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-x64-simulator": {
          "args": "--platform=ios --arch=x64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-arm64": {
          "commands": [
            "pnpm run build:ts",
            "pnpm exec bare-make generate --platform=darwin --arch=arm64",
            "pnpm exec bare-make build",
            "pnpm exec bare-make install",
            "node scripts/smoke-packaged.cjs"
          ],
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "commands": [
            "pnpm run build:ts",
            "pnpm exec bare-make generate --platform=darwin --arch=x64",
            "pnpm exec bare-make build",
            "pnpm exec bare-make install",
            "node scripts/smoke-packaged.cjs"
          ],
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "commands": [
            "pnpm run build:ts",
            "pnpm exec bare-make generate --platform=win32 --arch=x64",
            "pnpm exec bare-make build",
            "pnpm exec bare-make install",
            "node scripts/smoke-packaged.cjs"
          ],
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "cpp:lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "@qvac/fabric"
          ],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/ggml-rpc-server",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm exec bare-make generate -D ENABLE_VULKAN=OFF",
            "forwardAllArgs": false
          },
          {
            "command": "node ../../scripts/ci/cpp-lint-changed.mjs --base {args.diff-base}",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120
      }
    },
    "cpp:build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "@qvac/fabric"
          ],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/ggml-rpc-server",
        "parallel": false,
        "commands": [
          "pnpm run test:cpp:build"
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      }
    },
    "cpp:tests": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "cpp:build"
      ],
      "options": {
        "cwd": "packages/ggml-rpc-server",
        "parallel": false,
        "commands": [
          "pnpm run test:cpp:run"
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 60
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/ggml-rpc-server",
        "parallel": false,
        "commands": [
          {
            "command": "node ../../scripts/ci/run-integration.mjs",
            "forwardAllArgs": true
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-arm64": {
          "ci": {
            "runner": "ubuntu_2204_arm"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 30
      }
    },
    "test:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ggml-rpc-server",
        "command": "echo no mobile preparation"
      },
      "configurations": {
        "android-arm64": {
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "ios-arm64": {
          "ci": {
            "runner": "macos_ios"
          }
        }
      },
      "metadata": {
        "mobile": {
          "devicefarmProject": "LLM",
          "enablesPerf": false
        }
      }
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "ggml-rpc-server"
        }
      }
    }
  },
  "implicitDependencies": [
    "qvac-addon-cmake"
  ]
}

{
  "name": "@qvac/ggml-rpc-server",
  "root": "packages/ggml-rpc-server",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'carved out of on-pr-nx.yml; orchestrated by on-pr-ggml-rpc-server.yml'",
        "cwd": "packages/ggml-rpc-server",
        "ci": {
          "carveOut": true,
          "hasCppLint": true,
          "hasTsChecks": true,
          "tsChecksMode": "dts+lint"
        }
      }
    }
  }
}

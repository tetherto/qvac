{
  "name": "@qvac/langdetect-text-cld2",
  "version": "0.4.0",
  "description": "Language detection using CLD2 with same API as @qvac/langdetect-text",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "coverage": "nyc npm run test",
    "test": "npm run test:unit",
    "lint": "prettier --check \"**/*.{js,cjs,mjs}\" && lunte",
    "format": "prettier --write \"**/*.{js,cjs,mjs}\"",
    "test:dts": "tsc index.d.ts --noEmit",
    "test:unit:generate": "brittle -r test/unit/all.js test/unit/*.test.js",
    "test:unit": "npm run test:unit:generate && bare test/unit/all.js"
  },
  "engines": {
    "bare": ">=1.0.0"
  },
  "author": "Tether",
  "license": "Apache-2.0",
  "dependencies": {
    "bare-module": "^6.2.0",
    "cld": "^2.10.1",
    "language-tags": "^1.0.9"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "brittle": "3.10.0",
    "lunte": "^1.8.0",
    "nyc": "17.1.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/langdetect-text-cld2"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://qvac.tether.io",
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE"
  ]
}

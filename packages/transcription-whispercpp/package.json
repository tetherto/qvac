{
  "name": "@qvac/transcription-whispercpp",
  "version": "0.12.0",
  "description": "transcription addon for qvac",
  "addon": true,
  "engines": {
    "bare": ">=1.19.0"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:ts && npm run test:types",
    "lint:js": "prettier --check \"examples/**/*.js\" \"test/**/*.js\" \"binding.js\" && lunte \"examples/**/*.js\" \"test/**/*.js\" \"binding.js\"",
    "lint:ts": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:ts:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"examples/**/*.js\" \"test/**/*.js\" \"binding.js\"",
    "build": "npm run build:ts && npm run build:native",
    "build:native": "bare-make generate && bare-make build && bare-make install",
    "build:ts": "tsc -p tsconfig.build.json",
    "check:generated": "npm run build:ts && node ./scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:types": "npm run typecheck && npm run check:generated",
    "test:unit": "npm run build:ts && brittle-bare test/unit/**/*.test.js",
    "test:integration": "npm run build:ts && brittle-bare test/integration/addon.test.js",
    "test:benchmark:rtf": "brittle-bare test/benchmark/rtf-benchmark.test.js",
    "test:integration:long": "npm run build:ts && brittle-bare test/integration/**/longES.test.js",
    "test:cpp:build": "bare-make generate -D BUILD_TESTING=ON && bare-make build --target test-whisper-core && bare-make install",
    "test:cpp:run": "cd build/addon/tests/ && LLVM_PROFILE_FILE=default.profraw ./test-whisper-core --gtest_output=xml:cpp-test-results.xml",
    "test:cpp": "npm run test:cpp:build && npm run test:cpp:run",
    "coverage:cpp:build": "bare-make generate -D BUILD_TESTING=ON -D ENABLE_COVERAGE=ON && bare-make build --target test-whisper-core",
    "coverage:cpp:summary": "cd build/addon/tests && llvm-cov report ./test-whisper-core --instr-profile=coverage.profdata -ignore-filename-regex='(tests|build|node_modules|gtest|gmock|\\.vcpkg|/usr)/' > coverage-summary.txt",
    "coverage:cpp:report": "cd build/addon/tests/ && ls -lha && llvm-profdata merge -sparse default.profraw -o coverage.profdata && llvm-cov show ./test-whisper-core -instr-profile=coverage.profdata -format=html -output-dir=coverage-html -ignore-filename-regex='(tests|build|node_modules|gtest|gmock|\\.vcpkg|/usr)/' && llvm-cov export ./test-whisper-core -instr-profile=coverage.profdata -format=lcov -ignore-filename-regex='(tests|build|node_modules|gtest|gmock|\\.vcpkg|/usr)/' > lcov.info && npm run coverage:cpp:summary",
    "coverage:cpp": "npm run coverage:cpp:build && npm run test:cpp:run && npm run coverage:cpp:report",
    "test:integration:multiple": "npm run build:ts && brittle-bare test/integration/**/multiple-transcriptions.test.js",
    "test:integration:chunking": "npm run build:ts && brittle-bare test/integration/audio-ctx-chunking.test.js",
    "test:integration:live-stream-simultion": "npm run build:ts && brittle-bare test/integration/live-stream-simulation.test.js",
    "test:integration:corrupted-model": "npm run build:ts && brittle-bare test/integration/corrupted-model.test.js",
    "test:integration:model-file-validation": "npm run build:ts && brittle-bare test/integration/model-file-validation.test.js",
    "test:integration:accuracy": "npm run build:ts && brittle-bare test/integration/accuracy-multilang.test.js",
    "test:integration:gpu": "npm run build:ts && brittle-bare test/integration/gpu.test.js",
    "test:unit:reload:esraw": "npm run build:ts && brittle-bare test/stand-alone/addon.reload.esraw.test.js",
    "test:stand-alone:gpu": "brittle-bare test/stand-alone/seed-vulkan-gpu-speed.test.js",
    "test:stand-alone:gpu-speed": "brittle-bare test/stand-alone/seed-vulkan-gpu-speed.test.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:integration:multiple && npm run test:integration:chunking && npm run test:integration:live-stream-simultion && npm run test:integration:corrupted-model && npm run test:integration:model-file-validation && npm run test:integration:gpu",
    "test:dts": "npm run test:types",
    "download-models": "./scripts/download-models.sh",
    "prepare:husky": "husky"
  },
  "files": [
    "addonLogging.js",
    "addonLogging.d.ts",
    "binding.js",
    "configChecker.js",
    "configChecker.d.ts",
    "index.js",
    "whisper.js",
    "whisper.d.ts",
    "prebuilds",
    "index.d.ts",
    "lib",
    "transcription-addon",
    "test/mobile",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/transcription-whispercpp"
  },
  "author": "Tether",
  "keywords": [
    "tether",
    "addon",
    "whisper",
    "qvac"
  ],
  "license": "Apache-2.0",
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://qvac.tether.io",
  "devDependencies": {
    "@qvac/decoder-audio": "^0.5.0",
    "@types/node": "^22.15.3",
    "bare-buffer": "^3.4.2",
    "bare-ffmpeg": "^1.0.0-32",
    "bare-process": "^4.2.2",
    "bare-stream": "^2.7.0",
    "brittle": "^3.17.0",
    "cmake-bare": "^1.7.5",
    "cmake-vcpkg": "^1.1.0",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lunte": "^1.8.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@qvac/error": "^0.1.0",
    "@qvac/infer-base": "^0.6.0",
    "@qvac/logging": "^0.1.0",
    "bare-fs": "^4.7.1",
    "bare-path": "^3.0.0"
  },
  "exports": {
    "./package": "./package.json",
    "./transcription-addon": {
      "types": "./transcription-addon/index.d.ts",
      "default": "./transcription-addon/index.js"
    },
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./addonLogging": {
      "types": "./addonLogging.d.ts",
      "default": "./addonLogging.js"
    },
    "./addonLogging.js": "./addonLogging.js",
    "./binding.js": "./binding.js"
  },
  "types": "index.d.ts"
}

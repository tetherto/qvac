# Generated from the desktop suite by scripts/generate-mobile-integration-tests.js
# and regenerated in CI before the app is built, so it is deliberately NOT
# committed: committing it would mean every desktop-test change needs a manual
# regenerate+commit step that is easy to forget, and it adds noise to diffs.
# Run `npm run test:mobile:generate` locally before `npm test`.

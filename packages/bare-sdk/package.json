{
  "name": "@qvac/bare-sdk",
  "version": "0.18.2",
  "license": "Apache-2.0",
  "description": "Bare-targeted slim assembly of the QVAC SDK. A thin re-export of @qvac/inference: consumers install only the addon packages they need and register plugins explicitly. No addon dependencies pulled in by default.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/bare-sdk"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://qvac.tether.io",
  "keywords": [
    "ai",
    "bare",
    "deep-learning",
    "diffusion",
    "edge-ai",
    "embeddings",
    "gguf",
    "holepunch",
    "hyperswarm",
    "image-generation",
    "inference",
    "large-language-model",
    "llama-cpp",
    "llm",
    "local",
    "local-ai",
    "machine-learning",
    "ml",
    "model-registry",
    "ocr",
    "offline",
    "on-device",
    "p2p",
    "pear",
    "peer-to-peer",
    "private-ai",
    "qvac",
    "rag",
    "sdk",
    "self-hosted",
    "slim",
    "speech-to-text",
    "stt",
    "tether",
    "text-to-speech",
    "transcription",
    "translation",
    "tts",
    "typescript",
    "whisper"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package": "./package.json",
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./plugin-utils": {
      "types": "./dist/plugin-utils.d.ts",
      "import": "./dist/plugin-utils.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "import": "./dist/logging.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./commands": {
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    },
    "./worker-core": {
      "types": "./dist/worker-core.d.ts",
      "import": "./dist/worker-core.js"
    },
    "./*/plugin": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    }
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "!**/package-lock.json",
    "!**/yarn.lock",
    "!**/pnpm-lock.yaml",
    "!**/bun.lock",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepare": "bun run build",
    "sdk-source:workspace": "node ./scripts/link-workspace-inference.mjs",
    "link:self": "node ./scripts/link-self.mjs",
    "build:bare": "tsc -p test/bare/tsconfig.json",
    "build:bare:e2e": "tsc -p test/bare/tsconfig.e2e.json",
    "make:test:bare": "brittle-make-test test/dist/bare/all.mjs \"test/dist/bare/*.test.js\"",
    "make:test:bare:e2e": "brittle-make-test test/dist/bare/e2e/all.mjs \"test/dist/bare/e2e/*.test.js\" \"test/dist/bare/e2e/suite-teardown.js\"",
    "test:bare": "bun run build && bun run link:self && bun run build:bare && bun run make:test:bare && brittle-bare test/dist/bare/all.mjs",
    "test:bare:e2e": "bun run build && bun run link:self && bun run build:bare:e2e && bun run make:test:bare:e2e && brittle-bare test/dist/bare/e2e/all.mjs"
  },
  "engines": {
    "bare": "^1.30.3"
  },
  "dependencies": {
    "@qvac/inference": "^0.17.0"
  },
  "devDependencies": {
    "@types/brittle": "^3.5.0",
    "brittle": "^4.1.0",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@qvac/classification-ggml",
  "root": "packages/classification-ggml",
  "tags": [
    "ci:addons"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/classification-ggml"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:dts",
        "cwd": "packages/classification-ggml"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/classification-ggml"
      }
    },
    "verify:generated": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run check:generated",
        "cwd": "packages/classification-ggml"
      }
    },
    "ci:system": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^ci:system"
      ],
      "options": {
        "cwd": "packages/classification-ggml",
        "parallel": false,
        "forwardAllArgs": false,
        "commands": [
          "echo no system packages"
        ]
      },
      "configurations": {
        "linux-x64": {
          "commands": [
            "dpkg -s python3-venv >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y python3-venv)"
          ]
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "@qvac/fabric"
          ],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/classification-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm run build:ts",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make generate",
            "forwardAllArgs": true
          },
          {
            "command": "pnpm exec bare-make build",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make install",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "args": "--platform=linux --arch=x64",
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-arm64": {
          "args": "--platform=linux --arch=arm64",
          "ci": {
            "runner": "ubuntu_2204_arm"
          }
        },
        "android-arm64": {
          "args": "--platform=android --arch=arm64 -D ANDROID_STL=c++_shared",
          "ci": {
            "runner": "ubuntu_2404"
          }
        },
        "ios-arm64": {
          "args": "--platform=ios --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-arm64-simulator": {
          "args": "--platform=ios --arch=arm64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-x64-simulator": {
          "args": "--platform=ios --arch=x64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-arm64": {
          "args": "--platform=darwin --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "args": "--platform=darwin --arch=x64",
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "args": "--platform=win32 --arch=x64",
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "cpp:lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "@qvac/fabric"
          ],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/classification-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm exec bare-make generate -D ENABLE_VULKAN=OFF",
            "forwardAllArgs": false
          },
          {
            "command": "node ../../scripts/ci/cpp-lint-changed.mjs --base {args.diff-base}",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120
      }
    },
    "cpp:build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "@qvac/fabric"
          ],
          "target": "link:platform"
        }
      ],
      "options": {
        "cwd": "packages/classification-ggml",
        "parallel": false,
        "commands": [
          "pnpm run test:cpp:build"
        ]
      },
      "configurations": {
        "linux-x64": {
          "commands": [
            "pnpm run test:cpp:fuzz:configure",
            "pnpm run test:cpp:fuzz:build:tests",
            "pnpm run test:cpp:fuzz:build:fuzz"
          ],
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      }
    },
    "cpp:tests": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "cpp:build"
      ],
      "options": {
        "cwd": "packages/classification-ggml",
        "parallel": false,
        "commands": [
          "pnpm run test:cpp:run"
        ]
      },
      "configurations": {
        "linux-x64": {
          "commands": [
            "node ci/test-converter.mjs",
            "pnpm run test:cpp:fuzz:run"
          ],
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 60
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/classification-ggml",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm run test:package",
            "forwardAllArgs": false
          },
          {
            "command": "node ../../scripts/ci/run-integration.mjs --set QVAC_CLASSIFICATION_TRACE=1",
            "forwardAllArgs": true
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "ubuntu_2204"
          }
        },
        "linux-x64-2404": {
          "ci": {
            "runner": "ubuntu_2404"
          }
        },
        "linux-arm64": {
          "ci": {
            "runner": "ubuntu_2204_arm"
          }
        },
        "darwin-arm64": {
          "args": "--set QVAC_MEGALOC_EXPECT_GPU=1",
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "win32-x64": {
          "args": "--set QVAC_MEGALOC_EXPECT_GPU=1",
          "ci": {
            "runner": "win_2025_x64_gpu"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 30
      }
    },
    "test:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/classification-ggml",
        "command": "node ci/prepare-mobile.mjs"
      },
      "configurations": {
        "android-arm64": {
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "ios-arm64": {
          "ci": {
            "runner": "macos_ios"
          }
        }
      },
      "metadata": {
        "mobile": {
          "devicefarmProject": "LLM",
          "enablesPerf": false
        }
      }
    },
    "cache:models": {
      "executor": "nx:noop"
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "classification-ggml"
        }
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp",
    "qvac-addon-cmake"
  ]
}

{
  "include": ["src/**/*"],
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "esnext",
    "types": [],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "noEmit": true,
    "esModuleInterop": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleDetection": "force"
  }
}

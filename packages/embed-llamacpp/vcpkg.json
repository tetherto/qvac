{
  "name": "embed-llamacpp",
  "version-string": "0.32.0",
  "dependencies": [
    {
      "name": "opencl",
      "platform": "android"
    },
    {
      "name": "qvac-fabric",
      "version>=": "10297.1.0#1",
      "features": [
        {
          "name": "cuda-backend",
          "platform": "linux & x64"
        },
        "vector-index"
      ]
    },
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.3.3"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    }
  ],
  "features": {
    "tests": {
      "description": "Build and run unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "vk-profiling": {
      "description": "Force vk performance logging in qvac-fabric",
      "dependencies": [
        {
          "name": "qvac-fabric",
          "features": [
            "force-profiler"
          ]
        }
      ]
    }
  }
}

{
  "name": "embed-llamacpp",
  "version-string": "0.32.0",
  "dependencies": [
    {
      "name": "opencl",
      "platform": "android"
    },
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.4.0"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    }
  ],
  "features": {
    "tests": {
      "description": "Build and run unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "fuzz": {
      "description": "Build fuzz targets (Google FuzzTest dependencies)",
      "dependencies": [
        {
          "name": "abseil",
          "version>=": "20260526.0",
          "features": [
            "asan"
          ]
        },
        "antlr4",
        {
          "name": "fuzztest",
          "version>=": "2026-06-29",
          "features": [
            "asan"
          ]
        },
        "gtest",
        {
          "name": "re2",
          "version>=": "2025-11-05",
          "features": [
            "asan"
          ]
        }
      ]
    }
  }
}

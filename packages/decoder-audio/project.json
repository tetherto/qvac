{
  "name": "@qvac/decoder-audio",
  "root": "packages/decoder-audio",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/decoder-audio",
        "ci": {
          "_syntheticTestMarker": "test-on-pr-nx-dispatch"
        }
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/decoder-audio"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/decoder-audio",
        "ci": {
          "envVarName": "QASE_API_TOKEN",
          "envSecretName": "QASE_API_TOKEN",
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64-gpu" },
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64-gpu" },
            { "os": "ubuntu-24.04-arm", "platform": "linux", "arch": "arm64" },
            { "os": "macos-15-large", "platform": "darwin", "arch": "x64" },
            { "os": "macos-14", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64-gpu" }
          ]
        }
      }
    },
    "test:integration-mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:mobile:validate || true",
        "cwd": "packages/decoder-audio",
        "ci": {
          "npmName": "@qvac/decoder-audio",
          "deviceFarmProjectArnPrimary": "AWS_DEVICE_FARM_PROJECT_ARN_DECODER_AUDIO",
          "androidDevicePoolArnPrimary": "ANDROID_DEVICE_POOL_ARN_DECODER_AUDIO",
          "iosDevicePoolArnPrimary": "IOS_DEVICE_POOL_ARN_DECODER_AUDIO",
          "enablesPerf": false
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/decoder-audio"
      }
    },
    "test:dts": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:dts",
        "cwd": "packages/decoder-audio"
      }
    }
  }
}

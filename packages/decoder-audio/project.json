{
  "name": "@qvac/decoder-audio",
  "root": "packages/decoder-audio",
  "tags": [
    "ci:contract"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/decoder-audio",
        "command": "pnpm run lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/decoder-audio",
        "command": "pnpm run test:dts"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/decoder-audio",
        "command": "pnpm run test:unit"
      }
    },
    "verify:generated": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/decoder-audio",
        "command": "pnpm run check:generated"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/decoder-audio",
        "parallel": false,
        "commands": [
          {
            "command": "node ../../scripts/ci/run-integration.mjs",
            "forwardAllArgs": true
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        },
        "linux-x64-2404": {
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "linux-arm64": {
          "ci": {
            "runner": "ubuntu_2404_arm"
          }
        },
        "darwin-x64": {
          "ci": {
            "runner": "macos_15_large"
          }
        },
        "darwin-arm64": {
          "ci": {
            "runner": "macos_arm64_gpu"
          }
        },
        "win32-x64": {
          "ci": {
            "runner": "win_2025_x64_gpu"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 540,
        "secrets": [
          "QASE_API_TOKEN"
        ]
      }
    },
    "test:mobile": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/decoder-audio",
        "command": "node ci/prepare-mobile.mjs"
      },
      "configurations": {
        "android-arm64": {
          "ci": {
            "runner": "linux_ubuntu2404_x64"
          }
        },
        "ios-arm64": {
          "ci": {
            "runner": "macos_ios"
          }
        }
      },
      "metadata": {
        "mobile": {
          "devicefarmProject": "DECODER_AUDIO",
          "enablesPerf": false,
          "mochaTimeoutMs": 600000
        }
      }
    },
    "cache:models": {
      "executor": "nx:noop"
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "decoder-audio"
        }
      }
    }
  }
}

# Run with: cmake -P test/cmake/cuda-options.cmake
cmake_minimum_required(VERSION 3.25)

function(check_cuda name host toolkit tests fuzz explicit expected)
  set(CMAKE_HOST_SYSTEM_NAME "${host}")
  set(ENV{QVAC_CUDA_TOOLKIT} "${toolkit}")
  set(BUILD_TESTING "${tests}")
  set(BUILD_FUZZING "${fuzz}")
  unset(SD_CUDA CACHE)
  unset(SD_CUDA)
  if(NOT explicit STREQUAL "default")
    set(SD_CUDA "${explicit}" CACHE BOOL "Explicit caller selection")
  endif()
  set(VCPKG_MANIFEST_FEATURES vulkan)
  include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ConfigureCuda.cmake")
  if(NOT SD_CUDA STREQUAL expected)
    message(FATAL_ERROR "${name}: SD_CUDA=${SD_CUDA}, expected ${expected}")
  endif()
  if(expected)
    set(expected_features "vulkan;cuda")
  else()
    set(expected_features vulkan)
  endif()
  if(NOT VCPKG_MANIFEST_FEATURES STREQUAL expected_features)
    message(FATAL_ERROR "${name}: features=${VCPKG_MANIFEST_FEATURES}")
  endif()
  message(STATUS "${name}: PASS")
endfunction()

check_cuda(source Linux "" OFF OFF default OFF)
check_cuda(ci-release Linux 13.0.88-server OFF OFF default ON)
check_cuda(unit-tests Linux 13.0.88-server ON OFF default OFF)
check_cuda(fuzz Linux 13.0.88-server OFF ON default OFF)
check_cuda(explicit-off Linux 13.0.88-server OFF OFF OFF OFF)
check_cuda(explicit-on Linux "" OFF OFF ON ON)
check_cuda(other-host Darwin 13.0.88-server OFF OFF default OFF)

+        return 1;
+    }
+    if (!golden.empty()) {
+        session.noise_override = [golden](int block, int step, float* dst, size_t n) -> bool {
+            char nm[512];
+            if (step < 0) {
+                snprintf(nm, sizeof(nm), "%s/b%d_s0_xt.npy", golden.c_str(), block);
+            } else {
+                snprintf(nm, sizeof(nm), "%s/b%d_s%d_eps.npy", golden.c_str(), block, step);
+            }
+            std::vector<float> g;

    },
    "@qvac/embed-llamacpp": {
      "optional": true
    },
    "@qvac/langdetect-text": {
      "optional": true
    },
    "@qvac/llm-llamacpp": {
      "optional": true
    },
    "@qvac/ocr-ggml": {

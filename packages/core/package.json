    }
  },
  "devDependencies": {
    "@qvac/bci-whispercpp": "^0.3.3",
    "@qvac/classification-ggml": "^0.7.1",
    "@qvac/decoder-audio": "^0.5.0",
    "@qvac/diffusion-cpp": "^0.12.1",
    "@qvac/embed-llamacpp": "^0.23.1",
    "@qvac/langdetect-text": "^0.1.2",
    "@qvac/llm-llamacpp": "^0.31.2",
    "@qvac/ocr-ggml": "^0.7.1",
    "@qvac/transcription-parakeet": "^0.8.3",
    "@qvac/transcription-whispercpp": "^0.10.2",
    "@qvac/translation-nmtcpp": "^6.3.1",
    "@qvac/tts-ggml": "^0.3.6",
    "@qvac/vla-ggml": "^0.7.0",
    "@types/brittle": "^3.5.0",
    "bare-stdio": "^1.0.2",
    "brittle": "^4.1.0",
    "lunte": "^1.8.4",
    "prettier": "^3.9.4",

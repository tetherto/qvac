{
  "name": "@qvac/core",
  "version": "0.14.1",
  "description": "Bare-only in-process core of the QVAC SDK. Runs inference directly on the Bare runtime with explicit plugin assembly and no RPC, worker, or subprocess layer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://qvac.tether.io",
  "keywords": [
    "ai",
    "bare",
    "core",
    "diffusion",
    "edge-ai",
    "embeddings",
    "gguf",
    "holepunch",
    "hyperswarm",
    "inference",
    "large-language-model",
    "llama-cpp",
    "llm",
    "local",
    "local-ai",
    "ocr",
    "offline",
    "on-device",
    "p2p",
    "peer-to-peer",
    "qvac",
    "rag",
    "speech-to-text",
    "tether",
    "text-to-speech",
    "transcription",
    "translation",
    "tts",
    "typescript"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package": "./package.json",
    "./plugins": "./src/plugins/index.ts",
    "./plugin-utils": "./src/schemas/plugin.ts",
    "./logging": "./src/logging/index.ts",
    "./models": "./src/models/registry/index.ts",
    "./llamacpp-completion/plugin": "./src/plugins/builtin/llamacpp-completion/plugin.ts",
    "./llamacpp-embedding/plugin": "./src/plugins/builtin/llamacpp-embedding/plugin.ts",
    "./whispercpp-transcription/plugin": "./src/plugins/builtin/whispercpp-transcription/plugin.ts",
    "./bci-whispercpp-transcription/plugin": "./src/plugins/builtin/bci-whispercpp-transcription/plugin.ts",
    "./parakeet-transcription/plugin": "./src/plugins/builtin/parakeet-transcription/plugin.ts",
    "./nmtcpp-translation/plugin": "./src/plugins/builtin/nmtcpp-translation/plugin.ts",
    "./tts-ggml/plugin": "./src/plugins/builtin/tts-ggml/plugin.ts",
    "./ggml-ocr/plugin": "./src/plugins/builtin/ggml-ocr/plugin.ts",
    "./sdcpp-generation/plugin": "./src/plugins/builtin/sdcpp-generation/plugin.ts",
    "./ggml-vla/plugin": "./src/plugins/builtin/ggml-vla/plugin.ts",
    "./ggml-classification/plugin": "./src/plugins/builtin/ggml-classification/plugin.ts"
  },
  "files": [
    "src/**/*",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "lint": "lunte",
    "lint:fix": "lunte --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "brittle-bare 'test/**/*.test.ts'",
    "test:bare": "bun run test"
  },
  "engines": {
    "bare": "^1.30.3"
  },
  "dependencies": {
    "@qvac/error": "^0.1.1",
    "@qvac/logging": "^0.1.1",
    "@qvac/rag": "^0.6.4",
    "@qvac/registry-client": "^0.6.1",
    "bare-abort-controller": "^1.1.2",
    "bare-buffer": "^3.6.1",
    "bare-crypto": "^1.15.3",
    "bare-env": "^3.0.0",
    "bare-fetch": "^3.0.1",
    "bare-fs": "^4.7.4",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-rpc": "^1.3.8",
    "bare-stream": "^2.13.3",
    "bare-zlib": "^1.4.0",
    "compact-encoding": "^3.3.0",
    "corestore": "^7.11.0",
    "fast-safe-stringify": "2.1.1",
    "hyperdrive": "^13.3.3",
    "hyperswarm": "^4.17.0",
    "semver": "^7.8.5",
    "tar-stream": "^3.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@qvac/bci-whispercpp": "^0.3.2",
    "@qvac/classification-ggml": "^0.7.0",
    "@qvac/decoder-audio": "^0.5.0",

include_guard(GLOBAL)

# Import the development libraries from the same platform package as the addon.
# Call for dynamic-backend platform packages.
function(qvac_fabric_import_shared_core prebuilds host)
  get_filename_component(prebuilds "${prebuilds}" ABSOLUTE)
  qvac_fabric_module_name("${host}" module)
  get_filename_component(directory "${prebuilds}/${host}/${module}" ABSOLUTE)
  if(NOT EXISTS "${directory}/qvac-shared-core.cmake")
    message(FATAL_ERROR "No shared-core metadata in ${directory}; use a matching fabric package")
  endif()
  set(_qvac_core_abi "")
  set(_qvac_core_definitions "")
  include("${directory}/qvac-shared-core.cmake")
  if(NOT _qvac_core_abi STREQUAL "1")
    message(FATAL_ERROR "Unsupported QVAC shared-core ABI: ${_qvac_core_abi}")
  endif()
  if(NOT "GGML_SHARED" IN_LIST _qvac_core_definitions)
    message(FATAL_ERROR "Shared-core metadata must declare GGML_SHARED: ${directory}")
  endif()
  foreach(library ggml-base ggml ggml-vector-index)
    set(target qvac-fabric::${library})
    if(host MATCHES "^win32-")
      set(location "${prebuilds}/${host}/qvac-${library}-1.dll")
      set(implib "${directory}/qvac-${library}-1.lib")
      if(NOT EXISTS "${implib}")
        message(FATAL_ERROR "Missing shared-core import library: ${implib}")
      endif()
    else()
      set(location "${directory}/libqvac-${library}-1.so")
    endif()
    if(NOT EXISTS "${location}")
      message(FATAL_ERROR "Missing shared-core library: ${location}")
    endif()
    if(TARGET ${target})
      get_target_property(existing ${target} IMPORTED_LOCATION)
      if(NOT existing STREQUAL location)
        message(FATAL_ERROR "Cannot mix shared-core packages: ${existing} and ${location}")
      endif()
      continue()
    endif()
    add_library(${target} SHARED IMPORTED GLOBAL)
    set_target_properties(${target} PROPERTIES
      IMPORTED_LOCATION "${location}"
      INTERFACE_LINK_LIBRARIES qvac-fabric::headers
      INTERFACE_COMPILE_DEFINITIONS "${_qvac_core_definitions}")
    if(host MATCHES "^win32-")
      set_target_properties(${target} PROPERTIES IMPORTED_IMPLIB "${implib}")
    endif()
    if(NOT library STREQUAL "ggml-base")
      set_property(TARGET ${target} APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES qvac-fabric::ggml-base)
    endif()
  endforeach()
endfunction()

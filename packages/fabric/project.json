{
  "name": "@qvac/fabric",
  "root": "packages/fabric",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'carved out of on-pr-nx.yml; orchestrated by on-pr-fabric.yml (fabric overlay needs fabric built before its consumers, which one flat prebuild matrix cannot express)'",
        "cwd": "packages/fabric",
        "ci": {
          "carveOut": true,
          "sanityVariant": "inline",
          "hasCppLint": true
        }
      }
    },
    "ci:system": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^ci:system"
      ],
      "options": {
        "cwd": "packages/fabric",
        "parallel": false,
        "forwardAllArgs": false,
        "commands": [
          "echo no system packages"
        ]
      },
      "configurations": {
        "linux-x64": {
          "commands": [
            "dpkg -s libibverbs-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs-dev)"
          ]
        },
        "linux-x64-gpu": {
          "commands": [
            "dpkg -s libibverbs-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs-dev)"
          ]
        },
        "linux-arm64": {
          "commands": [
            "dpkg -s libibverbs-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs-dev)"
          ]
        },
        "linux-arm64-2404": {
          "commands": [
            "dpkg -s libibverbs-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs-dev)"
          ]
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "packages/fabric",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm exec bare-make generate -D BUILD_TESTING=OFF",
            "forwardAllArgs": true
          },
          {
            "command": "pnpm exec bare-make build",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make install",
            "forwardAllArgs": false
          }
        ],
        "ci": {
          "artifactNamePrefix": "fabric-",
          "includeVulkanSdk": true,
          "includeRocm": true,
          "includeCuda": true,
          "includeCudaWin32": true,
          "includeCudaArm64": true,
          "includeCudaArm64Jetson": true,
          "linuxExtraPackages": "libibverbs-dev"
        }
      },
      "configurations": {
        "linux-x64": {
          "args": "--platform=linux --arch=x64"
        },
        "linux-arm64": {
          "args": "--platform=linux --arch=arm64"
        },
        "android-arm64": {
          "args": "--platform=android --arch=arm64 -D ANDROID_STL=c++_shared"
        },
        "ios-arm64": {
          "args": "--platform=ios --arch=arm64"
        },
        "ios-arm64-simulator": {
          "args": "--platform=ios --arch=arm64 --simulator"
        },
        "ios-x64-simulator": {
          "args": "--platform=ios --arch=x64 --simulator"
        },
        "darwin-arm64": {
          "args": "--platform=darwin --arch=arm64"
        },
        "darwin-x64": {
          "args": "--platform=darwin --arch=x64"
        },
        "win32-x64": {
          "args": "--platform=win32 --arch=x64"
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "link:platform": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/fabric",
        "command": "pnpm run link:platform"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/fabric"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/fabric"
      }
    },
    "on-merge": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-merge-nx.yml'",
        "cwd": "packages/fabric",
        "ci": {
          "nameTransform": "none",
          "repoName": "fabric",
          "testGateMode": "none",
          "prebuildExtraDirs": [
            "include",
            "share"
          ],
          "slicePlatformPackages": true
        }
      }
    }
  },
  "implicitDependencies": [
    "lint-cpp"
  ]
}

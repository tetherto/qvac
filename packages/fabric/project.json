{
  "name": "@qvac/fabric",
  "root": "packages/fabric",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'carved out of on-pr-nx.yml; orchestrated by on-pr-fabric.yml (fabric overlay needs fabric built before its consumers, which one flat prebuild matrix cannot express)'",
        "cwd": "packages/fabric",
        "ci": {
          "carveOut": true,
          "sanityVariant": "inline",
          "hasCppLint": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/fabric",
        "ci": {
          "artifactNamePrefix": "fabric-",
          "includeVulkanSdk": true,
          "includeRocm": true
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/fabric"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/fabric"
      }
    },
    "on-merge": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-merge-nx.yml'",
        "cwd": "packages/fabric",
        "ci": {
          "buildStep": "none",
          "nameTransform": "none",
          "repoName": "fabric",
          "testGateMode": "none"
        }
      }
    }
  },
  "implicitDependencies": [
    "lint-cpp"
  ]
}

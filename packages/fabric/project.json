{
  "name": "@qvac/fabric",
  "root": "packages/fabric",
  "tags": [
    "ci:contract"
  ],
  "targets": {
    "ci:system": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^ci:system"
      ],
      "options": {
        "cwd": "packages/fabric",
        "parallel": false,
        "forwardAllArgs": false,
        "commands": [
          "echo no system packages"
        ]
      },
      "configurations": {
        "linux-x64": {
          "commands": [
            "dpkg -s libibverbs-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs-dev)"
          ]
        },
        "linux-x64-gpu": {
          "commands": [
            "dpkg -s libibverbs-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs-dev)"
          ]
        },
        "linux-arm64": {
          "commands": [
            "dpkg -s libibverbs-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs-dev)"
          ]
        },
        "linux-arm64-2404": {
          "commands": [
            "dpkg -s libibverbs-dev >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y libibverbs-dev)"
          ]
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "cwd": "packages/fabric",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm exec bare-make generate -D BUILD_TESTING=OFF",
            "forwardAllArgs": true
          },
          {
            "command": "pnpm exec bare-make build",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec bare-make install",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "args": "--platform=linux --arch=x64",
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          },
          "commands": [
            {
              "command": "pnpm exec bare-make generate -D BUILD_TESTING=OFF",
              "forwardAllArgs": true
            },
            {
              "command": "pnpm exec bare-make build",
              "forwardAllArgs": false
            },
            {
              "command": "pnpm exec bare-make install",
              "forwardAllArgs": false
            },
            {
              "command": "node ci/verify-cuda-modules.mjs linux-x64",
              "forwardAllArgs": false
            }
          ]
        },
        "linux-arm64": {
          "args": "--platform=linux --arch=arm64",
          "ci": {
            "runner": "ubuntu_2204_arm",
            "setup": [
              "cuda-jetson"
            ]
          },
          "commands": [
            {
              "command": "pnpm exec bare-make generate -D BUILD_TESTING=OFF",
              "forwardAllArgs": true
            },
            {
              "command": "pnpm exec bare-make build",
              "forwardAllArgs": false
            },
            {
              "command": "pnpm exec bare-make install",
              "forwardAllArgs": false
            },
            {
              "command": "node ci/build-jetson.mjs",
              "forwardAllArgs": true
            }
          ]
        },
        "android-arm64": {
          "args": "--platform=android --arch=arm64 -D ANDROID_STL=c++_shared",
          "ci": {
            "runner": "ubuntu_2404"
          }
        },
        "ios-arm64": {
          "args": "--platform=ios --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-arm64-simulator": {
          "args": "--platform=ios --arch=arm64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "ios-x64-simulator": {
          "args": "--platform=ios --arch=x64 --simulator",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-arm64": {
          "args": "--platform=darwin --arch=arm64",
          "ci": {
            "runner": "macos_15"
          }
        },
        "darwin-x64": {
          "args": "--platform=darwin --arch=x64",
          "ci": {
            "runner": "macos_15_intel"
          }
        },
        "win32-x64": {
          "args": "--platform=win32 --arch=x64",
          "commands": [
            {
              "command": "node ../../scripts/ci/msvc-env.mjs pnpm exec bare-make generate -D BUILD_TESTING=OFF",
              "forwardAllArgs": true
            },
            {
              "command": "node ../../scripts/ci/msvc-env.mjs pnpm exec bare-make build",
              "forwardAllArgs": false
            },
            {
              "command": "node ../../scripts/ci/msvc-env.mjs pnpm exec bare-make install",
              "forwardAllArgs": false
            },
            {
              "command": "node ci/verify-cuda-modules.mjs win32-x64",
              "forwardAllArgs": false
            }
          ],
          "ci": {
            "runner": "win_2025_x64"
          }
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "link:platform": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "packages/fabric",
        "command": "pnpm run link:platform"
      }
    },
    "cpp:lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/fabric",
        "parallel": false,
        "commands": [
          {
            "command": "pnpm exec bare-make generate -D ENABLE_VULKAN=OFF",
            "forwardAllArgs": false
          },
          {
            "command": "node ../../scripts/ci/cpp-lint-changed.mjs --base {args.diff-base}",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "linux-x64": {
          "ci": {
            "runner": "linux_ubuntu2204_x64"
          }
        }
      },
      "metadata": {
        "timeoutMinutes": 120
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/fabric"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/fabric"
      }
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "fabric",
          "platformPackages": true
        },
        "prebuildExtraDirs": [
          "include",
          "share"
        ]
      }
    }
  },
  "implicitDependencies": [
    "lint-cpp"
  ]
}

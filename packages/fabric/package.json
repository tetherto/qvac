{
  "name": "@qvac/fabric",
  "version": "0.11.0",
  "description": "Shared bare addon hosting the qvac-fabric (forked llama.cpp + ggml) runtime for QVAC inference addons",
  "addon": true,
  "engines": {
    "bare": ">=1.24.0"
  },
  "scripts": {
    "build": "bare-make generate && bare-make build && bare-make install",
    "build:pack": "mkdir -p dist && npm pack --pack-destination dist",
    "mobile:copy-prebuilds": "cp -r prebuilds/android-arm64 prebuilds/android-ia32 || echo 'Warning: Failed to copy fabric prebuilds to android-ia32'; cp -r prebuilds/android-arm64 prebuilds/android-arm || echo 'Warning: Failed to copy fabric prebuilds to android-arm'; cp -r prebuilds/android-arm64 prebuilds/android-x64 || echo 'Warning: Failed to copy fabric prebuilds to android-x64'; cp -r prebuilds/ios-arm64 prebuilds/ios-arm64-simulator 2>/dev/null || echo 'iOS prebuilds already present'; cp -r prebuilds/ios-arm64 prebuilds/ios-x64-simulator 2>/dev/null || echo 'iOS prebuilds already present'",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test:integration:install": "npm --prefix test/integration install",
    "test:integration": "npm --prefix test/integration install && bare test/integration/shared-runtime.test.js",
    "test:unit": "node --test scripts/*.test.js",
    "prepare-platform-packages": "node scripts/prepare-platform-packages.js"
  },
  "files": [
    "binding.js",
    "platform.js",
    "platform.d.ts",
    "prebuilds/include",
    "prebuilds/share/qvac-fabric",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./binding.js",
    "./package": "./package.json",
    "./platform": {
      "types": "./platform.d.ts",
      "default": "./platform.js"
    }
  },
  "imports": {
    "#binding": {
      "android": "@qvac/fabric-android-arm64",
      "darwin": {
        "arm64": "@qvac/fabric-darwin-arm64",
        "x64": "@qvac/fabric-darwin-x64"
      },
      "ios": "@qvac/fabric-ios",
      "linux": {
        "arm64": "@qvac/fabric-linux-arm64",
        "x64": "@qvac/fabric-linux-x64"
      },
      "win32": {
        "x64": "@qvac/fabric-win32-x64"
      }
    }
  },
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/fabric"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://github.com/tetherto/qvac/tree/main/packages/fabric#readme",
  "devDependencies": {
    "cmake-bare": "^1.7.5",
    "cmake-vcpkg": "^1.1.0",
    "standard": "^17.0.0"
  },
  "optionalDependencies": {
    "@qvac/fabric-linux-x64": "0.11.0",
    "@qvac/fabric-linux-arm64": "0.11.0",
    "@qvac/fabric-darwin-arm64": "0.11.0",
    "@qvac/fabric-darwin-x64": "0.11.0",
    "@qvac/fabric-win32-x64": "0.11.0",
    "@qvac/fabric-android-arm64": "0.11.0",
    "@qvac/fabric-ios": "0.11.0"
  }
}

{
  "name": "@qvac/fabric",
  "version": "0.21.0",
  "description": "Shared bare addon hosting the qvac-fabric (forked llama.cpp + ggml) runtime for QVAC inference addons",
  "engines": {
    "bare": ">=1.24.0"
  },
  "imports": {
    "#host-addon": {
      "linux": {
        "x64": "@qvac/fabric-linux-x64",
        "arm64": "@qvac/fabric-linux-arm64",
        "default": "./addon-unavailable.js"
      },
      "darwin": {
        "arm64": "@qvac/fabric-darwin-arm64",
        "x64": "@qvac/fabric-darwin-x64",
        "default": "./addon-unavailable.js"
      },
      "win32": {
        "x64": "@qvac/fabric-win32-x64",
        "default": "./addon-unavailable.js"
      },
      "android": {
        "arm64": "@qvac/fabric-android-arm64",
        "default": "./addon-unavailable.js"
      },
      "ios": "@qvac/fabric-ios",
      "default": "./addon-unavailable.js"
    }
  },
  "scripts": {
    "build": "bare-make generate && bare-make build && bare-make install && npm run link:platform",
    "link:platform": "node ../../scripts/ci/slice-platform-packages.mjs --link-local --workdir . --keep-dirs \"include share\"",
    "build:pack": "mkdir -p dist && npm pack --pack-destination dist",
    "lint": "prettier --check \"**/*.{js,cjs,mjs}\" && lunte",
    "format": "prettier --write \"**/*.{js,cjs,mjs}\"",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration:install": "npm --prefix test/integration install",
    "test:integration": "npm --prefix test/integration install && bare test/integration/shared-runtime.test.js"
  },
  "files": [
    "addon-unavailable.js",
    "binding.js",
    "prebuilds/*/*.bare",
    "prebuilds/*/*.bare.exports",
    "prebuilds/*/qvac__fabric-*/**",
    "prebuilds/include",
    "prebuilds/share/qvac-fabric",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./binding.js",
    "./package": "./package.json"
  },
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/fabric"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://github.com/tetherto/qvac/tree/main/packages/fabric#readme",
  "devDependencies": {
    "cmake-bare": "^1.9.0",
    "cmake-vcpkg": "^1.1.0",
    "cmake-npm": "^1.1.0",
    "lunte": "^1.8.4",
    "prettier": "^3.9.6",
    "prettier-config-holepunch": "^2.0.0"
  }
}

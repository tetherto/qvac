# Validate the experimental provider and all installed Linux clients, not host libraries.
function(qvac_check_shared_core)
    cmake_parse_arguments(PARSE_ARGV 0 arg "WITH_XDNA" "PROVIDER" "")
    find_program(QVAC_NM NAMES llvm-nm nm REQUIRED)
    find_program(QVAC_READELF NAMES llvm-readelf readelf REQUIRED)
    set(files ${arg_UNPARSED_ARGUMENTS})
    if(NOT files)
        message(FATAL_ERROR "qvac-fabric: no shared-core artifacts to validate")
    endif()
    set(xdna_found OFF)
    foreach(file IN LISTS files)
        get_filename_component(dir "${file}" DIRECTORY)
        if(arg_PROVIDER)
            set(provider "${arg_PROVIDER}")
        else()
            set(provider "${dir}/libqvac-ggml-base-1.so")
        endif()
        if(NOT EXISTS "${provider}")
            message(FATAL_ERROR "qvac-fabric: missing shared core provider for ${file}: ${provider}")
        endif()
        execute_process(COMMAND "${QVAC_NM}" -D --defined-only -P "${provider}"
            OUTPUT_VARIABLE exports COMMAND_ERROR_IS_FATAL ANY)
        if(NOT exports MATCHES "__cxa_throw@@QVAC_GGML_BASE_ABI_1 ")
            message(FATAL_ERROR "qvac-fabric: ${provider} has no versioned libc++ provider")
        endif()
        execute_process(COMMAND "${QVAC_READELF}" -d "${file}"
            OUTPUT_VARIABLE dynamic COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${QVAC_NM}" -D --undefined-only -P "${file}"
            OUTPUT_VARIABLE imports COMMAND_ERROR_IS_FATAL ANY)
        get_filename_component(name "${file}" NAME)
        set(gnu OFF)
        if(name MATCHES "^libqvac-ggml-(cuda(-jetson)?|xdna)\\.so$")
            set(gnu ON)
        endif()
        if(NOT file STREQUAL provider AND NOT dynamic MATCHES "\\[libqvac-ggml-base-1\\.so\\]")
            message(FATAL_ERROR "qvac-fabric: ${file} does not depend on the shared core")
        endif()
        if(dynamic MATCHES "\\[libc\\+\\+(abi)?\\.so" OR
           (NOT name STREQUAL "libqvac-ggml-xdna.so" AND dynamic MATCHES "\\[libstdc\\+\\+\\.so"))
            message(FATAL_ERROR "qvac-fabric: unexpected shared C++ runtime in ${file}")
        endif()
        if(name STREQUAL "libqvac-ggml-xdna.so")
            set(xdna_found ON)
            if(NOT arg_WITH_XDNA OR NOT dynamic MATCHES "\\[libstdc\\+\\+\\.so\\.6\\]" OR
               NOT dynamic MATCHES "\\[libxrt_coreutil\\.so\\.2\\]")
                message(FATAL_ERROR "qvac-fabric: XDNA must retain its XRT/shared GNU runtime")
            endif()
        endif()
        string(REPLACE "\n" ";" lines "${imports}")
        foreach(line IN LISTS lines)
            string(REGEX REPLACE " .*" "" symbol "${line}")
            string(REGEX REPLACE "@.*" "" unversioned "${symbol}")
            # A core reference must match a definition in this exact provider.
            if(symbol MATCHES "^(ggml|gguf|quantize|dequantize|iq2xs|iq3xs|qjl|tq[34]?)_")
                string(REPLACE "@QVAC" "@@QVAC" definition "${symbol}")
                if(NOT symbol MATCHES "@QVAC_GGML_BASE_ABI_1$" OR NOT exports MATCHES "(^|\n)${definition} ")
                    message(FATAL_ERROR "qvac-fabric: ${file} has an unowned core import: ${symbol}")
                endif()
            endif()
            if(gnu)
                if(symbol MATCHES "@QVAC_GGML_BASE_ABI_1$" AND NOT symbol MATCHES "^(ggml|gguf|quantize|dequantize|iq2xs|iq3xs|qjl|tq[34]?)_")
                    message(FATAL_ERROR "qvac-fabric: GNU backend imports libc++ from the core: ${symbol}")
                endif()
                if(NOT name STREQUAL "libqvac-ggml-xdna.so")
                    foreach(pattern IN LISTS _QVAC_CXX_RUNTIME_SYMBOLS)
                        if(unversioned MATCHES "${pattern}" AND NOT unversioned MATCHES "${_QVAC_CXX_RUNTIME_ALLOWED}")
                            message(FATAL_ERROR "qvac-fabric: CUDA leaves its private GNU runtime undefined: ${symbol}")
                        endif()
                    endforeach()
                endif()
                continue()
            endif()
            string(REGEX REPLACE "@.*" "" unversioned "${symbol}")
            if(unversioned MATCHES "${_QVAC_CXX_RUNTIME_ALLOWED}")
                continue()
            endif()
            foreach(pattern IN LISTS _QVAC_CXX_RUNTIME_SYMBOLS)
                if(unversioned MATCHES "${pattern}" AND NOT symbol MATCHES "@QVAC_GGML_BASE_ABI_1$")
                    message(FATAL_ERROR "qvac-fabric: ${file} has an unowned runtime import: ${symbol}")
                endif()
            endforeach()
        endforeach()
        if(NOT file STREQUAL provider)
            execute_process(COMMAND "${QVAC_NM}" -D --defined-only -P "${file}"
                OUTPUT_VARIABLE definitions COMMAND_ERROR_IS_FATAL ANY)
            if(definitions MATCHES "(^|\n)(__cxa_throw|ggml_backend_buffer_free)(@| )")
                message(FATAL_ERROR "qvac-fabric: ${file} still defines a private core/runtime")
            endif()
        endif()
    endforeach()
    if(arg_WITH_XDNA AND NOT xdna_found)
        message(FATAL_ERROR "qvac-fabric: requested XDNA module is missing")
    endif()
    message(STATUS "qvac-fabric: shared-core artifacts passed ownership validation")
endfunction()

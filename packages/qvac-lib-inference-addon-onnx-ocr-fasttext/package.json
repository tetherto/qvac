{
  "name": "@qvac/ocr-onnx",
  "version": "0.0.5",
  "description": "OCR addon for qvac",
  "addon": true,
  "engines": {
    "bare": ">=1.19.3"
  },
  "scripts": {
    "build": "bare-make generate && bare-make build && bare-make install",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test:unit": "bare test/unit/ocr.test.js",
    "test:example": "bare examples/example.fs.js",
    "test:integration": "bare test/integration/addon.test.js",
    "test": "npm run test:unit && npm run test:integration",

    "test:dts": "tsc index.d.ts --noEmit"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "ocr-fasttext.js",
    "supportedLanguages.js",
    "binding.js",
    "prebuilds",
    "models",
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac-lib-inference-addon-onnx-ocr-fasttext.git"
  },
  "author": "Tether",
  "keywords": [
    "tether",
    "addon",
    "qvac",
    "ocr"
  ],
  "license": "Apache-2.0",
  "bugs": "https://github.com/tetherto/qvac-lib-inference-addon-onnx-ocr-fasttext/issues",
  "homepage": "https://github.com/tetherto/qvac-lib-inference-addon-onnx-ocr-fasttext#readme",
  "standard": {
    "ignore": [
      "benchmarks/**",
      "examples/**"
    ]
  },
  "devDependencies": {
    "bare-fs": "^4.0.1",
    "brittle": "3.7.0",
    "bare-process": "^4.2.1",
    "cmake-bare": "^1.5.0",
    "cmake-vcpkg": "^1.0.2",
    "standard": "^17.0.0"
  },
  "dependencies": {
    "@qvac/response": "^0.1.2",
    "@qvac/infer-base": "^0.1.0",
    "@qvac/error": "^0.1.0",
    "bare-fs": "^4.5.1",
    "bare-process": "^4.2.1",
    "bare-path": "^3.0.0"
  },
  "exports": {
    "./package": "./package.json",
    ".": "./index.js"
  },
  "types": "index.d.ts"
}

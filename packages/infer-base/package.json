{
  "name": "@qvac/infer-base",
  "version": "0.6.1",
  "description": "Base class for inference clients",
  "main": "index.js",
  "scripts": {
    "lint": "prettier --check \"**/*.{js,cjs,mjs}\" && lunte",
    "format": "prettier --write \"**/*.{js,cjs,mjs}\"",
    "test:dts": "tsc index.d.ts --noEmit --esModuleInterop --target es2018 --moduleResolution node",
    "test:unit": "brittle-bare test/unit/**/*.test.js",
    "test": "npm run test:unit && npm run test:dts"
  },
  "author": "Tether",
  "keywords": [
    "tether",
    "inference",
    "qvac"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "bare-events": "^2.9.1",
    "bare-os": "^3.2.0"
  },
  "devDependencies": {
    "brittle": "^3.15.0",
    "lunte": "^1.8.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/infer-base"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "homepage": "https://qvac.tether.io",
  "files": [
    "src",
    "index.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "types": "index.d.ts"
}

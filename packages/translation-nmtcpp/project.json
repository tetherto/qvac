{
  "name": "@qvac/translation-nmtcpp",
  "root": "packages/translation-nmtcpp",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/translation-nmtcpp",
        "ci": {
          "includeVulkanSdk": true
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/translation-nmtcpp"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/translation-nmtcpp",
        "ci": {
          "testCommandSuffix": true,
          "useTeeLogging": true,
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64-gpu" },
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64-gpu" },
            { "os": "ubuntu-24.04-arm", "platform": "linux", "arch": "arm64" },
            { "os": "ubuntu-22.04-arm", "platform": "linux", "arch": "arm64" },
            { "os": "macos-14", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu" },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64-gpu" }
          ]
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/translation-nmtcpp"
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:cpp",
        "cwd": "packages/translation-nmtcpp"
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

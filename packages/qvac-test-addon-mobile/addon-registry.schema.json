{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "addon-registry.schema.json",
  "title": "QVAC Addon Registry",
  "description": "Schema for the addon compatibility registry",
  "type": "object",
  "required": ["addons"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "description": {
      "type": "string",
      "description": "Description of this registry file"
    },
    "version": {
      "type": "string",
      "description": "Version of the registry format",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "addons": {
      "type": "array",
      "description": "List of addons to test for compatibility",
      "items": {
        "type": "object",
        "required": ["name", "repository", "branch", "testPath", "platforms"],
        "properties": {
          "name": {
            "type": "string",
            "description": "NPM package name (e.g., @qvac/llm-llamacpp)",
            "pattern": "^@?[a-z0-9-]+(/[a-z0-9-]+)?$"
          },
          "repository": {
            "type": "string",
            "description": "GitHub repository (e.g., tetherto/qvac-lib-infer-llamacpp-llm)",
            "pattern": "^[a-zA-Z0-9-]+/[a-zA-Z0-9-_.]+$"
          },
          "branch": {
            "type": "string",
            "description": "Branch to test against",
            "default": "main"
          },
          "testPath": {
            "type": "string",
            "description": "Path to mobile tests within the addon",
            "default": "test/mobile"
          },
          "hasIntegrationTests": {
            "type": "boolean",
            "description": "Whether this addon has integration tests",
            "default": false
          },
          "prebuildArtifactPrefix": {
            "type": "string",
            "description": "Prefix for prebuild artifacts in CI"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the addon"
          },
          "priority": {
            "type": "string",
            "description": "Testing priority",
            "enum": ["high", "medium", "low"],
            "default": "medium"
          },
          "platforms": {
            "type": "array",
            "description": "Platforms to test on",
            "items": {
              "type": "string",
              "enum": ["Android", "iOS"]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this addon should be tested",
            "default": true
          },
          "skipInCI": {
            "type": "boolean",
            "description": "Skip this addon in CI (useful for addons under development)",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    "testSettings": {
      "type": "object",
      "description": "Global test settings",
      "properties": {
        "bundleId": {
          "type": "string",
          "description": "App bundle identifier"
        },
        "timeoutMinutes": {
          "type": "integer",
          "description": "Test timeout in minutes",
          "default": 120
        },
        "deviceFarmRegion": {
          "type": "string",
          "description": "AWS Device Farm region",
          "default": "us-west-2"
        }
      }
    }
  },
  "additionalProperties": false
}

Set Shell "zsh"
Set FontSize 16
Set Width 1400
Set Height 860
Set Padding 0
Set WindowBar Colorful
Set TypingSpeed 45ms
Set Theme { "background": "#08121a", "foreground": "#d4dfe6", "cursor": "#2bd8bd", "black": "#08121a", "brightBlack": "#354a56", "red": "#ffae9b", "brightRed": "#ffae9b", "green": "#83e7ac", "brightGreen": "#83e7ac", "yellow": "#b5a1e1", "brightYellow": "#b5a1e1", "blue": "#2bd8bd", "brightBlue": "#2bd8bd", "magenta": "#b5a1e1", "brightMagenta": "#b5a1e1", "cyan": "#2bd8bd", "brightCyan": "#2bd8bd", "white": "#d4dfe6", "brightWhite": "#ffffff" }

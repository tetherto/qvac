{
  "name": "@qvac/duck",
  "version": "0.1.0",
  "description": "QVAC chat in your terminal: a local agent, or one hosted on your other devices",
  "author": "Tether",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "duck": "./dist/index.js",
    "duck-bare": "./dist/bare.js"
  },
  "files": [
    "dist/**/*",
    "scripts",
    "docs",
    "LICENSE",
    "NOTICE",
    "!dist/runtime/**/*",
    "patches"
  ],
  "engines": {
    "node": "^22.21.0 || >=24.9.0"
  },
  "keywords": [
    "tether",
    "cli",
    "qvac",
    "duck",
    "chat",
    "bare"
  ],
  "bugs": "https://github.com/tetherto/qvac/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/duck"
  },
  "homepage": "https://qvac.tether.io",
  "scripts": {
    "prepublishOnly": "node scripts/check-publish-ready.mjs",
    "build": "rm -rf dist && tsc",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "lunte",
    "lint:fix": "lunte --fix",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run test:workbench",
    "test:unit": "npm run prepare:runtime && npm run test:workbench",
    "test:workbench": "npm run build && node --test test/workbench/*.test.mjs",
    "test:pty": "node --test --test-concurrency=1 --test-timeout=300000 test/workbench/pty/*.pty.mjs",
    "test:delegation": "node test/helpers/run-bare.mjs test/integration/delegation-smoke.mjs",
    "start": "node dist/index.js",
    "dev": "pnpm build && node dist/index.js",
    "capture": "node test/helpers/run-bare.mjs docs/demo/capture-product.mjs",
    "demo:record": "vhs docs/demo/boot.tape && vhs docs/demo/tour.tape && vhs docs/demo/coding.tape",
    "pack:local": "node scripts/pack-distribution.mjs",
    "pear:build": "npm run build && node scripts/make.mjs",
    "pear:stage": "npm run build && node scripts/make.mjs --stage",
    "postinstall": "node scripts/patch-dependencies.mjs",
    "prepare:runtime": "node scripts/patch-dependencies.mjs",
    "prepack": "node scripts/check-publish-ready.mjs"
  },
  "dependencies": {
    "@qvac/asr-ggml": "0.10.0",
    "@qvac/cli-kit": "workspace:*",
    "@qvac/audiogen-ggml": "0.8.0",
    "@qvac/bci-whispercpp": "0.12.0",
    "@qvac/classification-ggml": "0.31.1",
    "@qvac/core": "1.0.0-rc.2",
    "@qvac/decoder-audio": "0.8.1",
    "@qvac/diffusion-cpp": "0.30.0",
    "@qvac/embed-llamacpp": "0.48.2",
    "@qvac/ggml-rpc-server": "0.5.1",
    "@qvac/harness": "1.0.0-rc.10",
    "@qvac/inference": "0.22.0",
    "@qvac/langdetect-text": "^0.1.2",
    "@qvac/llm-llamacpp": "0.61.2",
    "@qvac/ocr-ggml": "0.29.1",
    "@qvac/skills": "0.1.18",
    "@qvac/translation-nmtcpp": "0.21.1",
    "@qvac/tts-ggml": "0.13.0",
    "@qvac/vla-ggml": "0.32.2",
    "autobee": "^2.11.8",
    "b4a": "^1.9.0",
    "bare-abort-controller": "1.1.2",
    "bare-crypto": "^1.15.3",
    "bare-events": "^2.9.1",
    "bare-ffmpeg": "^1.2.3",
    "bare-fs": "^4.7.2",
    "bare-http1": "4.5.9",
    "bare-https": "3.1.0",
    "bare-image-resample": "^1.0.2",
    "bare-link": "4.1.0",
    "bare-media": "^2.10.0",
    "bare-module": "7.1.0",
    "bare-module-traverse": "2.5.9",
    "bare-net": "^2.3.2",
    "bare-os": "^3.9.1",
    "bare-path": "3.0.1",
    "bare-pdfium": "1.7.1",
    "bare-process": "4.5.1",
    "bare-runtime": "1.34.0",
    "bare-sidecar": "0.5.7",
    "bare-stow": "0.1.7",
    "bare-subprocess": "^6.1.0",
    "bare-supervisor": "^0.1.1",
    "bare-thread": "1.2.7",
    "bare-tls": "3.2.0",
    "bare-tty": "^5.1.2",
    "bare-tui": "0.3.0",
    "bare-tui-updater": "0.0.1",
    "bare-url": "^2.4.5",
    "bare-worker": "4.5.0",
    "barevisor": "0.1.0",
    "compact-encoding": "^3.4.0",
    "corestore": "7.15.0",
    "fs-native-extensions": "^1.5.2",
    "fs-native-lock": "1.2.0",
    "hrpc": "^4.3.0",
    "hypercore": "11.39.0",
    "hypercore-crypto": "^3.7.0",
    "hyperdb": "^6.9.0",
    "hyperschema": "^1.23.0",
    "hyperswarm": "^4.17.1",
    "paparam": "^1.13.0",
    "pear-runtime-updater": "3.4.0",
    "ready-guard": "^1.0.0",
    "ready-resource": "^1.2.0",
    "safety-catch": "^1.0.3",
    "scope-lock": "^1.2.4",
    "streamx": "^2.28.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "bare-buffer": "3.7.1",
    "bare-build": "1.2.1",
    "bare-bundle": "1.11.0",
    "lunte": "^1.8.2",
    "lunte-plugin-qvac": "^0.2.0",
    "prettier": "^3.9.4",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "pyodide": "314.0.2",
    "quickjs-emscripten-core": "0.32.0"
  },
  "bundleDependencies": [
    "@qvac/cli-kit"
  ],
  "imports": {
    "#child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    },
    "#fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "#os": {
      "bare": "bare-os",
      "default": "os"
    },
    "#path": {
      "bare": "bare-path",
      "default": "path"
    },
    "#process": {
      "bare": "bare-process",
      "default": "process"
    },
    "#url": {
      "bare": "bare-url",
      "default": "url"
    }
  },
  "assets": [
    "dist/runtime/**"
  ],
  "overrides": {
    "@qvac/harness": "$@qvac/harness"
  }
}

{
  "name": "@qvac/tts-ggml",
  "root": "packages/tts-ggml",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/tts-ggml",
        "ci": {
          "hasCppLint": true,
          "hasCoload": true,
          "coloadActive": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/tts-ggml",
        "ci": {
          "artifactNamePrefix": "tts-ggml-",
          "linuxExtraPackages": "pkg-config libx11-dev libxcb1-dev libxkbcommon-dev",
          "includeVulkanSdk": true,
          "includeCuda": true,
          "platformCmakeDefines": "linux-x64: -D ENABLE_CUDA=ON\n"
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/tts-ggml"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/tts-ggml",
        "ci": {
          "timeoutMinutes": 120,
          "envVarName": "GITHUB_TOKEN",
          "envSecretName": "GITHUB_TOKEN",
          "runIntegrationTests": true,
          "linuxArmApt": ["libgomp1", "libomp5", "libblas3", "mesa-vulkan-drivers"],
          "windowsVulkan": { "setSdk": true, "visibleDevices": true },
          "modelCache": [
            {
              "paths": "packages/tts-ggml/models",
              "hashFilesGlob": "packages/tts-ggml/scripts/download-tts-ggml-models.js",
              "warm": "false"
            }
          ],
          "modelEnv": { "INTEGRATION_TEST_TIMEOUT": "1800", "LD_LIBRARY_PATH": "{workspace}/{workdir}/prebuilds/{platform}-{arch}:/usr/local/cuda/lib64", "DYLD_LIBRARY_PATH": "{workspace}/{workdir}/prebuilds/{platform}-{arch}" },
          "modelDownloadScript": "download-models:registry",
          "modelDownloadSkipOnCacheHit": true,
          "runRtfBenchmarks": false,
          "rtfBenchmark": {
            "command": "node scripts/run-rtf-benchmark-matrix.js",
            "matrixEnvVar": "QVAC_TTS_GGML_BENCHMARK_MATRIX_JSON"
          },
          "platforms": [

{
  "name": "@qvac/tts-ggml",
  "root": "packages/tts-ggml",
  "targets": {
    "on-pr": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by on-pr-nx.yml'",
        "cwd": "packages/tts-ggml",
        "ci": {
          "hasCppLint": true,
          "hasCoload": true,
          "coloadActive": true
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/tts-ggml",
        "ci": {
          "artifactNamePrefix": "tts-ggml-",
          "linuxExtraPackages": "pkg-config libx11-dev libxcb1-dev libxkbcommon-dev",
          "includeVulkanSdk": true
        }
      },
      "inputs": [
        "default",
        "!{projectRoot}/prebuilds/**"
      ],
      "outputs": [
        "{projectRoot}/prebuilds"
      ]
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/tts-ggml"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:integration",
        "cwd": "packages/tts-ggml",
        "ci": {
          "envVarName": "GITHUB_TOKEN",
          "envSecretName": "PAT_TOKEN",
          "runIntegrationTests": true,
          "runRtfBenchmarks": false,
          "rtfBenchmark": {
            "command": "node scripts/run-rtf-benchmark-matrix.js",
            "matrixEnvVar": "QVAC_TTS_GGML_BENCHMARK_MATRIX_JSON",
            "comboGroups": [
              [
                { "engine": "chatterbox" },
                { "engine": "chatterbox-mtl" },
                { "engine": "supertonic" },
                { "engine": "supertonic-mtl" },
                { "engine": "supertonic3" }
              ],
              [
                { "engine": "supertonic", "enhancer": "lavasr" },
                { "engine": "chatterbox", "enhancer": "lavasr" }
              ],
              [
                { "engine": "supertonic", "denoiser": "lavasr" },
                { "engine": "chatterbox", "denoiser": "lavasr" }
              ],
              [
                { "engine": "supertonic", "enhancer": "lavasr", "denoiser": "lavasr" },
                { "engine": "chatterbox", "enhancer": "lavasr", "denoiser": "lavasr" }
              ],
              [
                { "engine": "supertonic", "enhancer": "lavasr", "enhancerVariant": "f32" },
                { "engine": "supertonic", "enhancer": "lavasr", "enhancerVariant": "q8_0" }
              ]
            ]
          },
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64-gpu" },
            { "os": "ubuntu-24.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2404-x64-gpu" },
            { "os": "ubuntu-26.04", "platform": "linux", "arch": "x64", "noGpu": true },
            { "os": "ubuntu-24.04-arm", "platform": "linux", "arch": "arm64", "noGpu": true },
            { "os": "macos-26", "platform": "darwin", "arch": "arm64", "runner": "qvac-macos26-arm64-gpu" },
            { "os": "macos-15-large", "platform": "darwin", "arch": "x64", "noGpu": true },
            { "os": "windows-2025", "platform": "win32", "arch": "x64", "runner": "qvac-win25-x64-gpu" }
          ]
        }
      }
    },
    "test:integration-mobile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'orchestrated by integration-mobile-test-nx.yml'",
        "cwd": "packages/tts-ggml",
        "ci": {
          "npmName": "@qvac/tts-ggml",
          "prebuildArtifactPrefix": "tts-ggml-",
          "deviceFarmProjectArnPrimary": "AWS_DEVICE_FARM_PROJECT_ARN_TTS_GGML",
          "deviceFarmProjectArnFallback": "AWS_DEVICE_FARM_PROJECT_ARN_ONNX_TTS",
          "iosDevicePoolArnPrimary": "IOS_DEVICE_POOL_ARN_TTS_GGML",
          "iosDevicePoolArnFallback": "IOS_DEVICE_POOL_ARN_ONNX_TTS",
          "enablesPerf": false
        }
      }
    },
    "benchmark": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'benchmark orchestrated by benchmark-performance-nx.yml'",
        "cwd": "packages/tts-ggml",
        "ci": {
          "aggregateScript": "scripts/perf-report/aggregate-tts-ggml-rtf.js",
          "manualDir": "packages/tts-ggml/benchmarks/manual-results"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/tts-ggml"
      }
    },
    "test:cpp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:cpp",
        "cwd": "packages/tts-ggml",
        "ci": {
          "mode": "coverage",
          "platforms": [
            { "os": "ubuntu-22.04", "platform": "linux", "arch": "x64", "runner": "qvac-ubuntu2204-x64-gpu" }
          ],
          "hasCcache": true,
          "needsTtsVenvModels": true,
          "hardGateCommand": "cd build && ./tts_ggml_tests --gtest_filter='-*RealGguf*'",
          "buildOutputDir": "build",
          "testEnvVars": [
            { "name": "QVAC_TEST_CHATTERBOX_T3_GGUF", "path": "models/chatterbox-t3-mtl.gguf" },
            { "name": "QVAC_TEST_CHATTERBOX_S3GEN_GGUF", "path": "models/chatterbox-s3gen-mtl.gguf" },
            { "name": "QVAC_TEST_SUPERTONIC_GGUF", "path": "models/supertonic.gguf" }
          ]
        }
      }
    }
  },
  "implicitDependencies": [
    "inference-addon-cpp",
    "lint-cpp"
  ]
}

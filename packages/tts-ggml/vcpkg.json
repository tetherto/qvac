{
  "dependencies": [
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.5.0"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "qvac-fabric",
      "default-features": false,
      "version>=": "11259.2.0#1"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "tts",
        "coreml"
      ],
      "platform": "osx | ios"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "tts"
      ],
      "platform": "!(osx | ios)"
    }
  ],
  "features": {
    "fuzz": {
      "description": "Build fuzz targets (Google FuzzTest dependencies)",
      "dependencies": [
        {
          "name": "abseil",
          "version>=": "20260526.0",
          "features": [
            "asan"
          ]
        },
        "antlr4",
        {
          "name": "fuzztest",
          "version>=": "2026-06-29",
          "features": [
            "asan"
          ]
        },
        "gtest",
        {
          "name": "re2",
          "version>=": "2025-11-05",
          "features": [
            "asan"
          ]
        }
      ]
    },
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    }
  },
  "overrides": [
    {
      "name": "speech-cpp",
      "version": "2026-10-29",
      "port-version": 2
    }
  ]
}

{
  "dependencies": [
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.3.3"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-08-26#1",
      "default-features": false,
      "features": [
        "tts",
        "metal"
      ],
      "platform": "osx | ios"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-08-26#1",
      "default-features": false,
      "features": [
        "tts",
        "vulkan",
        "opencl"
      ],
      "platform": "android"
    },
    {
      "name": "speech-cpp",
      "version>=": "2026-08-26#1",
      "default-features": false,
      "features": [
        "tts",
        "vulkan"
      ],
      "platform": "!(osx | ios | android)"
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA GPU acceleration (Linux on NVIDIA). Not supported on Windows, where ggml-cuda links statically and the addon carries no CUDA runtime link.",
      "supports": "linux",
      "dependencies": [
        {
          "name": "speech-cpp",
          "version>=": "2026-08-26#1",
          "default-features": false,
          "features": [
            "cuda"
          ],
          "platform": "linux"
        }
      ]
    },
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "vulkan": {
      "description": "Enable Vulkan GPU acceleration",
      "dependencies": [
        {
          "name": "speech-cpp",
          "version>=": "2026-08-26#1",
          "default-features": false,
          "features": [
            "vulkan"
          ],
          "platform": "!(osx | ios)"
        }
      ]
    }
  }
}

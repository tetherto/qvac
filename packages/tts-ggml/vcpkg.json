{
  "dependencies": [
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.3.3"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "opencl",
        "tts",
        "vulkan"
      ],
      "platform": "android",
      "version>=": "2026-08-18"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "metal",
        "tts"
      ],
      "platform": "osx | ios",
      "version>=": "2026-08-18"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "tts",
        "vulkan"
      ],
      "platform": "!(osx | ios | android)",
      "version>=": "2026-08-18"
    }
  ],
  "features": {
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "vulkan": {
      "description": "Enable Vulkan GPU acceleration",
      "dependencies": [
        {
          "name": "speech-cpp",
          "default-features": false,
          "features": [
            "vulkan"
          ],
          "platform": "!(osx | ios)",
          "version>=": "2026-08-18"
        }
      ]
    }
  }
}

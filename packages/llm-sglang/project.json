{
  "name": "@qvac/llm-sglang",
  "root": "packages/llm-sglang",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/llm-sglang",
        "ci": {
          "installWithPnpm": true,
          "desktopSmokeCommand": "npm run build:ts && node --test test/integration/http.test.cjs",
          "matrixInclude": "[{\"os\":\"ubuntu-22.04\",\"runner_key\":\"linux_ubuntu2204_x64\",\"platform\":\"linux\",\"arch\":\"x64\"},{\"os\":\"ubuntu-22.04-arm\",\"runner_key\":\"ubuntu_2204_arm\",\"platform\":\"linux\",\"arch\":\"arm64\"}]"
        }
      },
      "inputs": ["default", "!{projectRoot}/prebuilds/**"],
      "outputs": ["{projectRoot}/prebuilds"]
    }
  }
}

{
  "name": "@qvac/ci",
  "root": "packages/qvac-ci",
  "tags": [
    "ci:libs"
  ],
  "targets": {
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:unit",
        "cwd": "packages/qvac-ci"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run lint",
        "cwd": "packages/qvac-ci"
      }
    },
    "publish:pre": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/qvac-ci",
        "command": "npm install && npm run lint && npm test"
      }
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "publish": {
          "tagPrefix": "qvac-ci"
        }
      }
    }
  }
}

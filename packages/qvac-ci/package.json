{
  "name": "@qvac/ci",
  "version": "0.2.1",
  "description": "CI utilities for the QVAC monorepo",
  "author": "Tether",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./main.js",
  "bin": {
    "qvac-ci": "./main.js"
  },
  "keywords": [
    "tether",
    "ci",
    "qvac"
  ],
  "files": [
    "main.js",
    "lib/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "lint": "prettier --check \"**/*.{js,cjs,mjs}\" && lunte",
    "format": "prettier --write \"**/*.{js,cjs,mjs}\"",
    "test:unit": "brittle-node test/unit/*.test.js test/unit/**/*.test.js",
    "test": "npm run test:unit",
    "audit": "npm audit --audit-level=high"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": "https://github.com/tetherto/qvac/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/qvac.git",
    "directory": "packages/qvac-ci"
  },
  "homepage": "https://qvac.tether.io",
  "dependencies": {
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1"
  },
  "devDependencies": {
    "brittle": "^3.10.1",
    "lunte": "^1.8.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}

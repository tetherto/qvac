---
description: Protect SDK constants exported to non-JavaScript consumers
globs:
  - packages/sdk/src/schemas/**
  - packages/sdk/index.ts
  - packages/sdk/src/client/api/**
  - packages/sdk/src/constants/**
  - packages/sdk/contract/**
alwaysApply: false

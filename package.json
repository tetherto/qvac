{
  "name": "qvac",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "quality:audit": "tsx scripts/code-quality/cli.ts audit",
    "quality:baseline": "tsx scripts/code-quality/cli.ts baseline",
    "quality:triage": "tsx scripts/code-quality/triage-cli.ts existing",
    "quality:reporting": "tsx scripts/code-quality/triage-cli.ts fresh",
    "quality:test": "tsx --test scripts/code-quality/test/*.test.ts",
    "quality:typecheck": "tsc -p scripts/code-quality/tsconfig.json"
  },
  "devDependencies": {
    "@nx/js": "23.1.0",
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.65.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "9.39.5",
    "nx": "23.1.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}

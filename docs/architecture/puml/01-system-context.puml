@startuml
!include <C4/C4_Context>
HIDE_STEREOTYPE()

title QVAC SDK - System Context

Person(dev, "Application Developer", "Integrates local AI into an application")

System(sdk, "QVAC SDK", "Runs models and retrieves application data on the device")

System_Ext(http, "HTTP / CDN", "Model artifacts")
System_Ext(p2p, "Holepunch Network", "QVAC Model Registry and Hyperdrive seeders")
System_Ext(remote, "GGML RPC Servers", "Optional remote inference devices")

Rel_D(dev, sdk, "Integrates inference and retrieval")
Rel_D(sdk, http, "Downloads model artifacts", "HTTP(S)")
Rel_D(sdk, p2p, "Discovers peers, queries catalog and syncs blobs", "Hyperswarm / Hypercore")
Rel_D(sdk, remote, "Offloads model operations", "GGML RPC")

Lay_R(http, p2p)
Lay_R(p2p, remote)
@enduml

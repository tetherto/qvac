@startuml
title Plugin Invocation Flow

participant "Client" as Client
participant "Dispatch" as Dispatch
participant "Plugin Registry" as PluginReg
participant "Handler" as Handler

Client -> Dispatch : invokePlugin({ modelId, handler, params })
Dispatch -> PluginReg : resolve handler
PluginReg -> Handler : validate request, execute
Handler --> Dispatch : result
Dispatch --> Client : result

@enduml

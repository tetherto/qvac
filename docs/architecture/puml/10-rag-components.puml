@startuml
!include <C4/C4_Component>
HIDE_STEREOTYPE()

title QVAC SDK - RAG 0.10 Integration Design

Container_Boundary(host, "Host") {
    Component(rag_api, "RAG API", "TypeScript / Python / Kotlin", "Ingestion and retrieval operations")
}

Container_Boundary(engine, "Inference Runtime") {
    Component(adapter, "Retrieval Adapter", "TypeScript", "Provides a Corestore and an embeddings port")
    Component(embeddings, "Embeddings Port", "TypeScript", "Embeds documents and queries in the configured space")
    Component(embed, "Embedding Model", "Native Addon", "Generates embeddings in the requested space")
    Component(rag, "RAG Core", "@qvac/rag", "Ingests documents and searches scoped namespaces")
    Component(index, "Derived Vector Index", "TurboVec", "Provides optional per-namespace candidates")
    ComponentDb(hyperdb, "RAG Records", "HyperDB on Corestore", "Stores namespace revisions, chunks and embeddings")
}

Rel_D(rag_api, adapter, "Calls retrieval operations")
Rel_D(adapter, rag, "Opens and calls retrieval")
Rel_L(rag, embeddings, "Requests embeddings")
Rel_L(embeddings, embed, "Runs the embedding model")
Rel_D(rag, hyperdb, "Commits and reads records")
Rel_D(rag, index, "Refreshes and searches candidate index")

@enduml

@startuml
!include <C4/C4_Component>
HIDE_STEREOTYPE()

title QVAC SDK - RAG Components

Container_Boundary(host, "Host") {
    Component(rag_api, "RAG API", "TypeScript / Python", "Workspace lifecycle and retrieval operations")
}

Container_Boundary(engine, "Engine") {
    Component(handlers, "RAG Handlers", "TypeScript", "Chunk, ingest, search, delete, reindex")
    Component(ws_mgr, "Workspace Manager", "TypeScript", "Open workspaces, bind embedding model")
    ComponentDb(hyperdb, "HyperDB", "Corestore", "Vector storage")
}

Container_Boundary(embed_model, "Embedding Model") {
    Component(embed, "embed()", "Native Addon", "llama.cpp embeddings")
}

Rel(rag_api, handlers, "Calls")
Rel(handlers, ws_mgr, "Uses")
Rel(ws_mgr, hyperdb, "Persists to")
Rel(handlers, embed, "Generates embeddings")

@enduml

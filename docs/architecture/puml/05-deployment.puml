@startuml
!include <C4/C4_Deployment>
HIDE_STEREOTYPE()

title QVAC SDK Family - Deployment Diagram

Deployment_Node(host_worker, "Host + Bare worker") {
    Deployment_Node(host_proc, "Host process") {
        Container(client, "Host Client", "TypeScript / Python")
    }
    Deployment_Node(worker_proc, "Bare worker") {
        Container(worker, "Worker + @qvac/inference", "TypeScript/C++")
    }
    ContainerDb(store_hw, "Local Storage", "Models cache + RAG DB")
}

Deployment_Node(inproc, "In-process Bare") {
    Deployment_Node(bare_app, "Bare Application") {
        Container(engine, "@qvac/inference", "TypeScript/C++")
    }
    ContainerDb(store_ip, "Local Storage", "Models cache + RAG DB")
}

Rel(client, worker, "RPC", "bare-rpc")
Rel(worker, store_hw, "Reads/writes", "filesystem / HyperDB")
Rel(engine, store_ip, "Reads/writes", "filesystem / HyperDB")

@enduml

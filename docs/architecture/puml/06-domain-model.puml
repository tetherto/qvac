@startuml
title Session, Request and Model Domain
hide circle
hide empty members

class "Caller Session" as Session {
    sessionId
}

class Request {
    requestId
    kind
}

class "Model Lease" as Lease
class "Loaded Model" as Model {
    modelId
    modelType
    configuration
}

class Plugin {
    modelType
    addonPackage
}

Session "1" -- "0..*" Request : owns
Session "1" -- "0..*" Lease : holds
Model "1" -- "1..*" Lease : retained by
Request "0..*" --> "0..1" Model : targets
Plugin "1" --> "0..*" Model : creates
@enduml

@startuml
title Model Loading Flow

participant "Client" as Client
participant "Handler" as Handler
participant "Download" as Download
participant "Plugin" as Plugin

Client -> Handler : loadModel({ modelSrc, modelType })
Handler -> Download : resolve and fetch source

note right of Download
  Source is a model constant, HTTP URL,
  registry entry, Hyperdrive path, or local file.
end note

Download --> Handler : model path
Handler -> Handler : take the model lock
alt Model ID already loaded
    break Model was reconfigured and caller has no lease
        Handler --> Client : ModelReconfiguredError
    end
    Handler -> Handler : add caller's lease
else First load of the resolved configuration
    opt Fit check enabled and supported
        Handler -> Plugin : assess fit using resolved files
        Plugin --> Handler : fit verdict
        break Policy refuses the load
            Handler --> Client : model fit error
        end
    end
    Handler -> Plugin : createModel(...)
    Plugin -> Plugin : load native addon
    Handler -> Handler : register model and caller lease
end
Handler --> Client : modelId

@enduml

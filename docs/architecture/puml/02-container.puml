@startuml
!include <C4/C4_Container>
HIDE_STEREOTYPE()

title QVAC SDK Family - Container Diagram

Person(dev, "Application Developer", "Integrates QVAC into JS, Python, Kotlin, or Bare apps on desktop and mobile")

System_Boundary(sdk, "QVAC SDK Family") {
    Container(client, "Host Client", "TypeScript / Python / Kotlin", "Public API, config, and RPC transport")
    Container(worker, "Bare Worker", "TypeScript on Bare", "RPC shell and process lifecycle")
    Container(engine, "@qvac/inference", "TypeScript on Bare", "Plugin host, local models, P2P distribution, registry, vector indexes")
    ContainerDb(cache, "Model Cache", "Filesystem", "Downloaded and expanded model artifacts")
}

System_Ext(http, "HTTP / CDN", "Direct model file downloads")
System_Ext(p2p, "Holepunch P2P Network", "QVAC Model Registry, Hyperdrive, and DHT")

Rel_D(dev, client, "Calls host API")
Rel_D(client, worker, "Calls worker", "bare-rpc over bare-stow IPC")
Rel_D(worker, engine, "In-process engine calls")
Rel_L(engine, cache, "Reads/writes models", "filesystem")
Rel_D(engine, http, "Downloads models", "HTTPS")
Rel_D(engine, p2p, "Catalog and model blob sync", "Holepunch")

Lay_D(client, worker)
Lay_D(worker, engine)
Lay_R(http, p2p)

@enduml

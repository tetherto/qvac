@startuml
!include <C4/C4_Container>
HIDE_STEREOTYPE()

title QVAC SDK - Worker-Backed Runtime

System_Boundary(sdk, "QVAC SDK") {
    Container(client, "Host Client", "TypeScript / Python / Kotlin", "Public API and caller handles")
    Container(worker, "Bare Worker", "Bare / TypeScript / C++", "RPC endpoint and in-process inference engine")
    ContainerDb(models, "Model Storage", "Filesystem / Corestore", "Model artifacts and registry blocks")
    ContainerDb(rag, "Retrieval Storage", "HyperDB on Corestore", "Documents, chunks and embeddings")
}

Rel_D(client, worker, "Calls the worker", "bare-rpc over bare-stow IPC")
Rel_D(worker, models, "Caches model artifacts")
Rel_D(worker, rag, "Persists and queries chunks")

Lay_R(models, rag)
@enduml

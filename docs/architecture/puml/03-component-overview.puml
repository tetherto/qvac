@startuml
!include <C4/C4_Component>
HIDE_STEREOTYPE()

title QVAC SDK - Bare Worker Components

Container_Ext(client, "Host Client", "TypeScript / Python / Kotlin", "Runs the host-side bare-stow harness")

Container_Boundary(worker, "Bare Worker") {
    Component(bridge, "Worker Entry and RPC Bridge", "bare-stow-runtime / bare-rpc", "Registers plugins and adapts RPC calls to engine dispatch")

    Boundary(engine, "@qvac/inference") {
        Component(dispatch, "Dispatch", "TypeScript / Zod", "Validates requests and routes operations")
        Component(state, "Runtime State", "TypeScript", "Tracks sessions, requests and loaded models")
        Component(plugins, "Inference Plugins", "TypeScript / C++", "Run operations through native addons")
        Component(artifacts, "Model Resolution", "TypeScript", "Resolves sources and caches artifacts")
        Component(rag, "Retrieval", "TypeScript", "Ingests and searches embedded content")
    }
}

Rel_R(client, bridge, "Calls worker", "bare-rpc over bare-stow IPC")
Rel_D(bridge, dispatch, "Forwards calls and abort signals")
Rel_D(dispatch, state, "Tracks work")
Rel_D(dispatch, plugins, "Routes model operations")
Rel_D(dispatch, artifacts, "Resolves files")
Rel_D(dispatch, rag, "Routes retrieval operations")

Lay_R(artifacts, state)
Lay_R(state, plugins)
Lay_R(plugins, rag)
@enduml

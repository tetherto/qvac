@startuml
!include <C4/C4_Component>

title QVAC SDK - Delegated Inference

Container_Boundary(provider, "Provider") {
    Component(listener, "DHT + RPC listener", "Hyperswarm", "Listens on a keypair and serves local inference")
    Component(local_model, "Local Models", "Native Addon", "Executes inference")
}

Container_Boundary(consumer, "Consumer") {
    Component(dialer, "DHT + RPC client", "Hyperswarm", "Connects by provider public key")
}

Rel(listener, local_model, "Invokes")
BiRel(dialer, listener, "Noise stream over DHT")

@enduml

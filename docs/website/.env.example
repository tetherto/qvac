# Production docs (Sevalla): set at build time on the app that serves https://docs.qvac.tether.io
# so static HTML declares index,follow. Omit on preview/staging/PR builds.
# DOCS_ALLOW_INDEXING=true

# The build runs in two phases, and each sizes its own parallelism from the core
# count the builder reports — the host's, not the container's share. Left alone
# on a 16-core builder it needs more than 12 GB and is killed by the kernel
# mid-phase, with no error and no log, because the overrun is native memory
# rather than a V8 heap it could abort on. The three variables below cap both
# phases and bring the whole build under 5 GB, at the cost of a slower compile.
# Set them as real build-time variables on every builder (Sevalla: Environment
# variables): Next and Turbopack read them at startup, before any .env file.

# How many workers the static generation phase runs, as `value - 1`. Each worker
# carries the Open Graph image renderer, so memory is per worker while time is
# per page; `2` yields the single worker this tree is tuned for. The name is
# Next's own: it reads CircleCI's variable before counting cores.
CIRCLE_NODE_TOTAL=2

# How many threads Turbopack compiles with. This is the variable that governs
# the compilation phase, which is where the build actually peaks — neither of
# the two around it reaches that phase at all. `1` compiles single-threaded,
# taking the compile from seconds to roughly three minutes, and is what brings
# the build under 5 GB. Measured on this tree: the default dies at 8 GB, `4`
# fits in 8 GB, `2` in 6 GB, `1` in 5 GB, and nothing fits in 4 GB. `1` is the
# last notch, so once content growth outgrows it the answer has to come from
# elsewhere — fewer retained lines, or a larger builder.
TURBO_TASKS_AVAILABLE_PARALLELISM=1

# Max old-space heap (in MB) each Node process may grow to before V8 aborts with
# "JavaScript heap out of memory". It is a ceiling, not a reservation: raising it
# on a small builder buys no memory, it only removes the brake that would have
# made V8 collect, and the kernel kills the process instead. Keep it well under
# the builder's RAM, since the container's OOM killer trumps V8's own limit. It
# bounds the generation phase only — compilation runs in Turbopack, which
# allocates outside V8's heap and is capped by the variable above instead.
NODE_OPTIONS=--max-old-space-size=2048

# Inkeep API Key for search and chat functionality
NEXT_PUBLIC_INKEEP_API_KEY=your_inkeep_api_key_here

# Path to the sdk package (used by scripts/generate-api-docs.ts).
# Example (Windows): SDK_PATH=D:\QVAC\qvac\packages\sdk
# Example (Unix):    SDK_PATH=/path/to/qvac/packages/sdk
SDK_PATH=

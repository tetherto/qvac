{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developer workflow local config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "defaultRemote": { "type": "string" },
        "staleDays": { "type": "number", "minimum": 1 },
        "requiredLabels": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": { "type": "string" },
        "pattern": { "type": "string" },
        "customFieldName": { "type": "string" }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statusChannel": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "diary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}

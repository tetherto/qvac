{
  "name": "@qvac/composable-agent-runtime-poc",
  "version": "0.0.0-poc",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "android:prebuild": "bun run --cwd apps/task-mobile android:prebuild",
    "android": "bun run --cwd apps/task-mobile android",
    "android:build": "bun run --cwd apps/task-mobile android:build",
    "android:release": "bun run --cwd apps/task-mobile android:release",
    "android:release:device": "bun run --cwd apps/task-mobile android:release:device",
    "test": "bun run scripts/test.ts",
    "test:supervisor": "bun run --cwd packages/supervisor test",
    "test:agents": "bun run --cwd packages/agents test",
    "test:sync": "bun run --cwd packages/sync test",
    "test:harness": "bun run --cwd packages/harness test",
    "test:assistant": "bun run --cwd packages/assistant test",
    "test:task-shared": "bun run --cwd apps/task-shared test",
    "test:task-cli": "bun run --cwd apps/task-cli test",
    "test:task-mobile": "bun run --cwd apps/task-mobile test",
    "typecheck:task-mobile": "bun run --cwd apps/task-mobile typecheck",
    "test:crash": "vitest run test/crash-isolation.test.ts",
    "test:subsets": "bun test test/subsets.test.ts",
    "test:artifacts": "vitest run packages/assistant/test/artifact-validation.test.ts",
    "test:pack": "bun run scripts/verify-clean-packages.ts",
    "validate:artifacts": "bun run scripts/validate-artifacts.ts",
    "lint:supervisor": "bun run --cwd packages/supervisor lint",
    "typecheck": "bun run scripts/typecheck.ts",
    "verify": "bun run scripts/verify.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "brittle": "^4.0.2",
    "hyperdht": "^6.32.0",
    "test-tmp": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "bare-pack": "2.1.3",
    "bare-runtime": "^1.30.0",
    "bare-module": "6.4.0",
    "bare-process": "4.5.0",
    "bare-tty": "5.1.1",
    "hypercore": "11.33.4"
  }
}

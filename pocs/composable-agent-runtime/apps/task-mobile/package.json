{
  "name": "@qvac-poc/task-mobile",
  "version": "0.0.0-poc",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "android:prebuild": "expo prebuild --clean --platform android --no-install",
    "preandroid": "bun run android:prebuild",
    "android": "expo run:android --device",
    "preandroid:build": "bun run android:prebuild",
    "android:build": "./android/gradlew -p android app:assembleDebug",
    "preandroid:release": "bun run android:prebuild",
    "android:release": "./android/gradlew -p android app:assembleRelease",
    "preandroid:release:device": "bun run android:prebuild",
    "android:release:device": "expo run:android --variant release --device",
    "test": "bun test src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qvac-poc/task-shared": "0.0.0-poc",
    "@qvac/assistant": "0.0.0-poc",
    "@qvac/sdk": "^0.15.0",
    "bare-link": "^3.3.0",
    "events": "^3.3.0",
    "expo": "^54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-file-system": "^19.0.21",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.14.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.1.17",
    "typescript": "^5.9.3"
  }
}

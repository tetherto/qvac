{
  "name": "@qvac/sync",
  "version": "0.0.0-poc",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "react-native": "./react-native.ts",
      "default": "./index.ts"
    },
    "./react-native": "./react-native.ts",
    "./package": "./package.json",
    "./profiles/durable-work": "./profiles/durable-work.ts",
    "./expo-plugin": "./dist/expo-plugin.js"
  },
  "files": [
    "package.json",
    "index.ts",
    "index.d.ts",
    "react-native.ts",
    "expo-plugin.ts",
    "dist/expo-plugin.js",
    "sidecar-entry.ts",
    "mobile-entry.ts",
    "react-native-launcher.ts",
    "react-native-stow.ts",
    "lib/**/*.ts",
    "lib/**/*.mjs",
    "profiles/**/*.ts",
    "schema/**/*",
    "spec/**/*",
    "generated/**/*"
  ],
  "imports": {
    "#process": {
      "bare": "bare-process",
      "default": "./lib/process.ts"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "url": {
      "bare": "bare-url",
      "default": "url"
    }
  },
  "scripts": {
    "build:schema": "bare schema/build.ts",
    "build:react-native": "bun -e \"import { buildSyncReactNativeBundle } from './lib/react-native-stow.ts'; await buildSyncReactNativeBundle()\"",
    "build:expo-plugin": "bun build expo-plugin.ts --target=node --format=esm --outfile=dist/expo-plugin.js --external=@expo/config-plugins --external=@expo/config-types --external=bare-* --external=react-native-bare-kit",
    "test": "bun test/run.ts all",
    "test:node": "bun test/run.ts node",
    "test:bare": "bun test/run.ts bare",
    "test:spawn": "bun test/run.ts spawn",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qvac/config": "0.0.0-poc",
    "@qvac/error": "^0.1.1",
    "@qvac/logging": "^0.1.0",
    "@qvac/supervisor": "0.0.0-poc",
    "autobee": "^1.0.10",
    "bare-bundle": "^1.10.0",
    "bare-fs": "^4.7.2",
    "bare-path": "^3.0.1",
    "bare-process": "4.5.0",
    "bare-sidecar": "0.5.3",
    "bare-stow": "0.1.5",
    "bare-stow-target-react-native": "0.1.1",
    "bare-url": "^2.4.5",
    "blind-pairing": "^2.3.1",
    "corestore": "^7.11.0",
    "hrpc": "^4.3.0",
    "hypercore": "11.33.4",
    "hypercore-crypto": "^3.7.0",
    "hypercore-storage": "^3.1.2",
    "hyperdb": "^6.7.0",
    "hyperdispatch": "^1.6.0",
    "hyperschema": "^1.21.0",
    "hyperschema-ts": "^0.1.0",
    "hyperswarm": "^4.17.0",
    "ready-resource": "^1.2.0",
    "streamx": "^2.28.0"
  },
  "peerDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "react-native-bare-kit": "^0.14.0"
  },
  "peerDependenciesMeta": {
    "react-native-bare-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "@expo/config-types": "^54.0.0",
    "@types/bun": "^1.3.14",
    "brittle": "^4.0.2",
    "hyperdht": "^6.32.0",
    "test-tmp": "^1.4.0",
    "typescript": "^5.9.3"
  }
}

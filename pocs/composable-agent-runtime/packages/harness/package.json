{
  "name": "@qvac/harness",
  "version": "0.0.0-poc",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./package": "./package.json",
    "./connect": "./lib/connect.ts",
    "./mobile-sdk-transport": "./lib/mobile-sdk-transport.ts",
    "./logger": "./lib/logger.ts",
    "./types": "./lib/types.ts",
    "./child-entry": "./child-entry.ts",
    "./mobile-entry": "./mobile-entry.ts",
    "./react-native-launcher": "./react-native-launcher.ts",
    "./react-native-stow": "./react-native-stow.ts",
    "./sdk-direct-adapter": "./lib/sdk-direct-adapter.ts",
    "./expo-plugin": "./dist/expo-plugin.js"
  },
  "imports": {
    "#abort-controller": {
      "bare": "bare-abort-controller",
      "default": "./lib/abort-controller.ts"
    }
  },
  "scripts": {
    "build:schema": "bare schema/build.ts",
    "build:react-native": "bun -e \"import { buildHarnessReactNativeBundle } from './lib/react-native-stow.ts'; await buildHarnessReactNativeBundle()\"",
    "build:expo-plugin": "bun build expo-plugin.ts --target=node --format=esm --outfile=dist/expo-plugin.js --external=@expo/config-plugins --external=@expo/config-types --external=bare-* --external=react-native-bare-kit",
    "test": "bun test/run.ts",
    "test:fast": "bun test/all.ts",
    "test:node": "node --experimental-strip-types ../../node_modules/brittle/brittle-node.js test/agent-state-store.ts",
    "test:bare": "brittle-bare test/all.ts",
    "test:spawn": "node --experimental-strip-types test/spawn.test.ts",
    "test:smoke:qwen": "QVAC_REAL_MODEL_SMOKE=1 node --experimental-strip-types test/qwen-smoke.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qvac/agents": "0.0.0-poc",
    "@qvac/error": "^0.1.1",
    "@qvac/logging": "^0.1.0",
    "@qvac/sdk": "0.15.0",
    "@qvac/sync": "0.0.0-poc",
    "@qvac/supervisor": "0.0.0-poc",
    "b4a": "^1.8.1",
    "bare-abort-controller": "^1.1.2",
    "bare-buffer": "^3.6.1",
    "bare-bundle": "^1.10.0",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.7.2",
    "bare-os": "^3.9.1",
    "bare-path": "^3.0.1",
    "bare-process": "4.5.0",
    "bare-sidecar": "^0.5.2",
    "bare-stow": "0.1.5",
    "bare-stow-target-react-native": "0.1.1",
    "bare-stream": "^2.13.3",
    "bare-url": "^2.4.5",
    "compact-encoding": "^3.3.0",
    "hrpc": "^4.3.0",
    "hyperschema": "^1.21.0",
    "streamx": "^2.28.0",
    "teex": "^1.0.1"
  },
  "peerDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "react-native-bare-kit": "^0.14.0"
  },
  "peerDependenciesMeta": {
    "react-native-bare-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "@expo/config-types": "^54.0.0",
    "brittle": "^4.0.2",
    "hyperdht": "^6.32.0",
    "test-tmp": "^1.4.0",
    "typescript": "^5.9.3"
  }
}

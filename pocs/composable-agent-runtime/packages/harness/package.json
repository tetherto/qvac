{
  "name": "@qvac/harness",
  "version": "0.0.0-poc",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./child-entry": "./child-entry.ts",
    "./sdk-direct-adapter": "./lib/sdk-direct-adapter.ts"
  },
  "imports": {
    "#abort-controller": {
      "bare": "bare-abort-controller",
      "default": "./lib/abort-controller.ts"
    }
  },
  "scripts": {
    "build:schema": "bare schema/build.ts",
    "test": "bun test/run.ts",
    "test:fast": "bun test/all.ts",
    "test:bare": "brittle-bare test/all.ts",
    "test:spawn": "node --experimental-strip-types test/spawn.test.ts",
    "test:smoke:qwen": "QVAC_REAL_MODEL_SMOKE=1 node --experimental-strip-types test/qwen-smoke.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qvac/agents": "0.0.0-poc",
    "@qvac/runtime-contracts": "0.0.0-poc",
    "@qvac/sdk": "0.15.0",
    "@qvac/supervisor": "0.0.0-poc",
    "b4a": "^1.8.1",
    "bare-abort-controller": "^1.1.2",
    "bare-buffer": "^3.6.1",
    "bare-events": "^2.9.1",
    "bare-sidecar": "^0.5.2",
    "bare-fs": "^4.7.2",
    "bare-os": "^3.9.1",
    "bare-path": "^3.0.1",
    "bare-process": "^4.4.1",
    "bare-stream": "^2.13.3",
    "bare-stow": "^0.1.4",
    "bare-url": "^2.4.5",
    "compact-encoding": "^3.3.0",
    "hrpc": "^4.3.0",
    "hyperschema": "^1.21.0",
    "streamx": "^2.28.0",
    "teex": "^1.0.1"
  },
  "devDependencies": {
    "brittle": "^4.0.2",
    "typescript": "^5.9.3"
  }
}

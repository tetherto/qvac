{
  "name": "@qvac/assistant",
  "version": "0.0.0-poc",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "react-native": "./react-native.ts",
      "default": "./index.ts"
    },
    "./react-native": "./react-native.ts",
    "./expo-plugin": "./dist/expo-plugin.js",
    "./package": "./package.json"
  },
  "files": [
    "package.json",
    "index.ts",
    "react-native.ts",
    "expo-plugin.ts",
    "dist/expo-plugin.js",
    "lib/**/*.ts",
    "examples/**/*.ts"
  ],
  "scripts": {
    "build:expo-plugin": "bun build expo-plugin.ts --target=node --format=esm --outfile=dist/expo-plugin.js --external=@expo/config-plugins --external=@expo/config-types --external=@qvac/sdk --external=@qvac/sync --external=@qvac/harness --external=bare-bundle --external=react-native-bare-kit",
    "inbox": "bun examples/assistant-inbox.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@qvac/config": "0.0.0-poc",
    "@qvac/error": "^0.1.1",
    "@qvac/harness": "0.0.0-poc",
    "@qvac/logging": "^0.1.0",
    "@qvac/supervisor": "0.0.0-poc",
    "@qvac/sync": "0.0.0-poc",
    "bare-bundle": "^1.10.0"
  },
  "peerDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "@qvac/sdk": "^0.15.0",
    "react-native-bare-kit": "^0.14.0"
  },
  "peerDependenciesMeta": {
    "react-native-bare-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "@expo/config-types": "^54.0.0",
    "@qvac/sdk": "^0.15.0",
    "@types/bun": "^1.3.14",
    "hyperdht": "^6.32.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
